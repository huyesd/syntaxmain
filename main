    AimSection:Toggle({ Name = "Keep Target", Flag = "keep_target", Default = false, Callback = function(v) S.keepTarget = v end })
    AimSection:Toggle({ Name = "Visible Only", Flag = "silent_visible", Default = false, Callback = function(v) S.silentVisibleCheck = v end })
    AimSection:Toggle({ Name = "Controller Support", Flag = "controller_support", Default = false, Callback = function(v) S.controllerSupport = v end })
    AimSection:Slider({
        Name = "Max Distance",
        Min = 1, Max = 2000, Default = 300,
        Flag = "silent_dist",
        Callback = function(v) S.silentDistance = tonumber(v) or S.silentDistance end
