do -- weapon indicators runtime (ammo / reload / tracers)
    local DrawingLib = S.DrawingLib
    local LocalPlayer = S.LocalPlayer
    local UIS = S.UIS
    local Workspace = S.Workspace

    local function ensureHudLabels()
        if not S.espGui then return end
        if not S.ammoLabel then
            local lab = Instance.new("TextLabel")
            lab.Name = "AmmoIndicator"
            lab.BackgroundTransparency = 1
            lab.Size = UDim2.fromOffset(160, 22)
            lab.Position = UDim2.new(0.5, -80, 1, -70)
            lab.Font = Enum.Font.SourceSansBold
            lab.TextSize = 18
            lab.TextStrokeTransparency = 0
            lab.TextStrokeColor3 = Color3.new(0, 0, 0)
            lab.Text = ""
            lab.Visible = false
            lab.Parent = S.espGui
            S.ammoLabel = lab
        end
        if not S.reloadLabel then
            local lab = Instance.new("TextLabel")
            lab.Name = "ReloadIndicator"
            lab.BackgroundTransparency = 1
            lab.Size = UDim2.fromOffset(160, 22)
            lab.Position = UDim2.new(0.5, -80, 1, -48)
            lab.Font = Enum.Font.SourceSansBold
            lab.TextSize = 16
            lab.TextStrokeTransparency = 0
            lab.TextStrokeColor3 = Color3.new(0, 0, 0)
            lab.Text = ""
            lab.Visible = false
            lab.Parent = S.espGui
            S.reloadLabel = lab
        end
    end

    local function readAmmo()
        local char = LocalPlayer.Character
        if not char then return nil, nil, false end
        local eq = char:FindFirstChild("Equipped")
        local tool = eq and eq:IsA("ObjectValue") and eq.Value or char:FindFirstChildOfClass("Tool")
        if not tool then return nil, nil, false end
        local ammo = tool:GetAttribute("Ammo") or tool:GetAttribute("ammo")
            or (tool:FindFirstChild("Ammo") and tool.Ammo.Value)
            or (tool:FindFirstChild("CurrentAmmo") and tool.CurrentAmmo.Value)
        local mag = tool:GetAttribute("MagSize") or tool:GetAttribute("MaxAmmo")
            or (tool:FindFirstChild("MagSize") and tool.MagSize.Value)
            or (tool:FindFirstChild("MaxAmmo") and tool.MaxAmmo.Value)
        local reloading = tool:GetAttribute("Reloading") == true
            or tool:GetAttribute("IsReloading") == true
            or (tool:FindFirstChild("Reloading") and tool.Reloading.Value == true)
        if type(ammo) ~= "number" then ammo = nil end
        if type(mag) ~= "number" then mag = nil end
        return ammo, mag, reloading, tool
    end

    local function ensureTracerFolder()
        if S.tracerFolder and S.tracerFolder.Parent then return S.tracerFolder end
        local folder = Instance.new("Folder")
        folder.Name = "SyntaxAimESP_Tracers"
        folder.Parent = Workspace
        S.tracerFolder = folder
        return folder
    end

    local function destroyTracerEntry(e)
        if not e then return end
        pcall(function()
            if e.beam then e.beam:Destroy() end
            if e.a0 then e.a0:Destroy() end
            if e.a1 then e.a1:Destroy() end
            if e.p0 then e.p0:Destroy() end
            if e.p1 then e.p1:Destroy() end
        end)
    end

    local function nextTracerTexture()
        if S.bulletTracerTexture and S.bulletTracerTexture ~= "cycle" then
            return S.bulletTracerTexture
        end
        local list = S.bulletTracerTextures
        local i = (S.bulletTracerTextureIndex or 1)
        local tex = list[((i - 1) % #list) + 1]
        S.bulletTracerTextureIndex = i + 1
        return tex
    end

    -- Beam tracers in world space (textures provided by user)
    local function spawnTracer(fromWorld, toWorld)
        if typeof(fromWorld) ~= "Vector3" or typeof(toWorld) ~= "Vector3" then return end
        if (toWorld - fromWorld).Magnitude < 0.5 then return end

        while #S.tracerLines >= 20 do
            local old = table.remove(S.tracerLines, 1)
            destroyTracerEntry(old)
        end

        local folder = ensureTracerFolder()
        local width = math.clamp(tonumber(S.bulletTracerThickness) or 0.2, 0.05, 1.5)
        local life = math.clamp(tonumber(S.bulletTracerLife) or 0.35, 0.05, 1.5)
        local tex = nextTracerTexture()

        local p0 = Instance.new("Part")
        p0.Name = "TracerA"
        p0.Anchored = true
        p0.CanCollide = false
        p0.CanQuery = false
        p0.CanTouch = false
        p0.Transparency = 1
        p0.Size = Vector3.new(0.1, 0.1, 0.1)
        p0.CFrame = CFrame.new(fromWorld)
        p0.Parent = folder

        local p1 = Instance.new("Part")
        p1.Name = "TracerB"
        p1.Anchored = true
        p1.CanCollide = false
        p1.CanQuery = false
        p1.CanTouch = false
        p1.Transparency = 1
        p1.Size = Vector3.new(0.1, 0.1, 0.1)
        p1.CFrame = CFrame.new(toWorld)
        p1.Parent = folder

        local a0 = Instance.new("Attachment")
        a0.Parent = p0
        local a1 = Instance.new("Attachment")
        a1.Parent = p1

        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Texture = tex
        beam.TextureMode = Enum.TextureMode.Stretch
        beam.TextureLength = 1
        beam.TextureSpeed = 0
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.Color = ColorSequence.new(S.bulletTracerColor)
        beam.Transparency = NumberSequence.new(0, 0.15)
        beam.Width0 = width
        beam.Width1 = width * 0.35
        beam.Segments = 10
        beam.Parent = p0

        S.tracerLines[#S.tracerLines + 1] = {
            beam = beam,
            a0 = a0,
            a1 = a1,
            p0 = p0,
            p1 = p1,
            born = os.clock(),
            life = life,
        }
    end

    -- pure visual beam tracers — no remote / gun path involvement
    S.track(UIS.InputBegan:Connect(function(input, gp)
        if gp or not S.bulletTracersEnabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if UIS:GetFocusedTextBox() then return end
        local cam = S.getCamera and S.getCamera()
        if not cam then return end

        local fromWorld = cam.CFrame.Position + cam.CFrame.LookVector * 1.5
        local toWorld = nil

        if S.silentTarget and S.silentTarget.Parent and S.silentTarget:IsA("BasePart") then
            toWorld = S.silentTarget.Position
        else
            local mouse = UIS:GetMouseLocation()
            local okRay, ray = pcall(function()
                return cam:ViewportPointToRay(mouse.X, mouse.Y)
            end)
            if okRay and ray then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { LocalPlayer.Character }
                params.IgnoreWater = true
                local hit = Workspace:Raycast(ray.Origin, ray.Direction * 800, params)
                toWorld = hit and hit.Position or (ray.Origin + ray.Direction * 400)
            end
        end

        if toWorld then
            spawnTracer(fromWorld, toWorld)
        end
    end))

    S.track(S.RunService.RenderStepped:Connect(function()
        if S.destroying then return end
        ensureHudLabels()

        if S.ammoIndicatorEnabled or S.reloadIndicatorEnabled then
            local ammo, mag, reloading = readAmmo()
            if S.ammoIndicatorEnabled and S.ammoLabel then
                if ammo ~= nil then
                    local text = mag and string.format("%d / %d", ammo, mag) or tostring(ammo)
                    S.ammoLabel.Text = text
                    S.ammoLabel.TextColor3 = S.ammoIndicatorColor
                    S.ammoLabel.Visible = true
                else
                    S.ammoLabel.Visible = false
                end
            elseif S.ammoLabel then
                S.ammoLabel.Visible = false
            end
            if S.reloadIndicatorEnabled and S.reloadLabel then
                if reloading then
                    S.reloadLabel.Text = "RELOADING"
                    S.reloadLabel.TextColor3 = S.reloadIndicatorColor
                    S.reloadLabel.Visible = true
                else
                    S.reloadLabel.Visible = false
                end
            elseif S.reloadLabel then
                S.reloadLabel.Visible = false
            end
        else
            if S.ammoLabel then S.ammoLabel.Visible = false end
            if S.reloadLabel then S.reloadLabel.Visible = false end
        end

        -- fade / cull beam tracers
        local now = os.clock()
        local alive = {}
        for _, e in ipairs(S.tracerLines) do
            local age = now - e.born
            if age >= e.life then
                destroyTracerEntry(e)
            else
                local t = age / e.life
                pcall(function()
                    if e.beam then
                        e.beam.Transparency = NumberSequence.new(t, math.min(1, t + 0.2))
                        e.beam.Width0 = (tonumber(S.bulletTracerThickness) or 0.2) * (1 - t * 0.5)
                        e.beam.Width1 = e.beam.Width0 * 0.35
                    end
                end)
                alive[#alive + 1] = e
            end
        end
        S.tracerLines = alive
    end))
end

do -- weapon mods core (server-safe)
    S.OldStatsFunc = nil
    S.GunConfigPatched = false
    S.GunConfigWarned = false

    local function cloneTableShallow(t) local o = {}; for k, v in pairs(t) do o[k] = v end; return o end

    local function patchStatsTable(stats)
        if type(stats) ~= "table" then return stats end
        local out = cloneTableShallow(stats)

        local function patchNumberFields(tbl)
            for k, v in pairs(tbl) do
                if type(v) == "number" then
                    local key = tostring(k):lower()
                    local noSpread = key:match("^spread") or key:match("spread$") or key:match("_spread")
                        or key:match("^bloom") or key:match("bloom$")
                        or key:match("^cone") or key:match("cone$") or key:match("_cone")
                    local noRecoil = key:match("^recoil") or key:match("recoil$") or key:match("_recoil")
                        or key:match("^kick") or key:match("kick$") or key:match("_kick")
                        or key:match("^sway") or key:match("sway$") or key:match("_sway")
                    if S.weaponNoSpread and noSpread then
                        tbl[k] = 0
                    elseif S.weaponNoRecoil and noRecoil then
                        tbl[k] = 0
                    end
                elseif type(v) == "table" then
                    tbl[k] = cloneTableShallow(v)
                    patchNumberFields(tbl[k])
                end
            end
        end
        patchNumberFields(out)

        if S.weaponRapidFire then
            local v = math.clamp(tonumber(S.weaponRapidFireValue) or 0.12, 0.08, 1)
            local rapidKeys = { "FireRate", "RPM", "RoundsPerMinute", "FireDelay", "ShotDelay", "PumpDelay", "Cooldown", "CycleTime" }
            for _, key in ipairs(rapidKeys) do
                if type(out[key]) == "number" then
                    if key == "FireRate" or key == "RPM" or key == "RoundsPerMinute" then
                        if key == "FireRate" then out[key] = math.max(out[key], 1 / v) else out[key] = math.max(out[key], 60 / v) end
                    else
                        out[key] = math.min(out[key], v)
                    end
                end
            end
        end

        if S.weaponInstantReload then
            local rv = math.clamp(tonumber(S.weaponReloadValue) or 0.15, 0.15, 5)
            local reloadKeys = { "ReloadTime", "ReloadDuration", "ReloadDelay", "ReloadSpeed" }
            for _, key in ipairs(reloadKeys) do
                if type(out[key]) == "number" then
                    if key == "ReloadSpeed" then out[key] = math.max(out[key], 1 / rv) else out[key] = math.min(out[key], rv) end
                end
            end
        end

        -- Range mod (GunConfig.Base.Range)
        if S.weaponRangeMod then
            local rv = math.clamp(tonumber(S.weaponRangeValue) or 1500, 50, 10000)
            if type(out.Range) == "number" then
                out.Range = math.max(out.Range, rv)
            else
                out.Range = rv
            end
        end

        -- No falloff: neutralize Falloff table (Start/End/Min/Max)
        if S.weaponNoFalloff then
            if type(out.Falloff) == "table" then
                out.Falloff = {
                    Start = 1e9,
                    End = 1e9,
                    Min = 1,
                    Max = 1,
                }
            end
        end

        -- Shell-by-shell reload off (Pump etc.)
        if S.weaponNoReloadPerShell then
            out.ReloadPerShell = false
        end

        if S.weaponDebug then
            print("[WeaponMods] GunConfig.Stats patched: rapid=" .. tostring(S.weaponRapidFire)
                .. " reload=" .. tostring(S.weaponInstantReload)
                .. " recoil=" .. tostring(S.weaponNoRecoil)
                .. " spread=" .. tostring(S.weaponNoSpread)
                .. " range=" .. tostring(S.weaponRangeMod)
                .. " noFalloff=" .. tostring(S.weaponNoFalloff)
                .. " noShellReload=" .. tostring(S.weaponNoReloadPerShell)
                .. " hitscan=" .. tostring(S.weaponHitscan))
        end

        return out
    end

    local function hookGunConfig()
        if S.GunConfigPatched then return true end
        local modules = S.ReplicatedStorage:FindFirstChild("Modules")
        local gcMod = modules and modules:FindFirstChild("GunConfig")
        if not gcMod then return false end
        local ok, gc = pcall(require, gcMod)
        if not ok or type(gc) ~= "table" or type(gc.Stats) ~= "function" then
            if not S.GunConfigWarned then
                S.GunConfigWarned = true
                warn("[SyntaxAimESP] GunConfig unavailable: " .. tostring(gc))
            end
            return false
        end
        S.OldStatsFunc = gc.Stats
        gc.Stats = function(...)
            local okS, stats = pcall(S.OldStatsFunc, ...)
            if not okS then return nil end
            local okP, patched = pcall(patchStatsTable, stats)
            if okP then return patched end
            return stats
        end
        S.GunConfigPatched = true
        return true
    end

    local function unhookGunConfig()
        if not S.GunConfigPatched then return end
        pcall(function()
            local modules = S.ReplicatedStorage:FindFirstChild("Modules")
            local gcMod = modules and modules:FindFirstChild("GunConfig")
            if gcMod then
                local ok, gc = pcall(require, gcMod)
                if ok and type(gc) == "table" and S.OldStatsFunc then gc.Stats = S.OldStatsFunc end
            end
        end)
        S.GunConfigPatched = false
        S.OldStatsFunc = nil
    end

    local function applyAll()
        local needsConfigHook = S.weaponRapidFire or S.weaponInstantReload or S.weaponNoRecoil or S.weaponNoSpread
            or S.weaponNoFalloff or S.weaponNoReloadPerShell or S.weaponRangeMod
        if needsConfigHook then hookGunConfig() else unhookGunConfig() end
    end
    S.applyAll = applyAll

    S.hookGunConfig = hookGunConfig
    S.unhookGunConfig = unhookGunConfig

    task.spawn(function() task.wait(1); applyAll() end)
end

do -- GunUtil (patched)
    local GunUtil = {}
    GunUtil.Seed = function(p1, p2)
        return ((tonumber(p1) or 0) % 2147483647) * 1000003 + (tonumber(p2) or 0)
    end
    GunUtil.Dirs = function(p3, p4, p5, p6)
        local count = math.clamp(math.floor(p5 and p5.Pellets or 1), 1, 20)
        local out = table.create(count)
        out[1] = p3
        if count == 1 then return out end
        if p4 <= 0 then
            for i = 2, count do out[i] = p3 end
            return out
        end
        local rng = Random.new(p6)
        local spreadRad = math.rad(p4)
        local baseCF = CFrame.lookAt(Vector3.zero, p3)
        local baseAngle = rng:NextNumber(0, 6.283185307179586)
        for i = 2, count do
            local t = (i - 1) / (count - 1) + rng:NextNumber(-0.08, 0.08)
            local rad = spreadRad * math.sqrt(math.clamp(t, 0.02, 1))
            local angle = baseAngle + (i - 1) * 2.39996323 + rng:NextNumber(-0.35, 0.35)
            local dx = math.cos(angle) * rad
            local dy = math.sin(angle) * rad
            out[i] = (baseCF * CFrame.Angles(dy, -dx, 0)).LookVector
        end
        return out
    end
    local function ignorable(p14)
        if p14:FindFirstAncestorOfClass("Accessory") ~= nil or (p14:FindFirstAncestorOfClass("Tool") ~= nil or p14:FindFirstAncestor("Items") ~= nil) then
            return true
        end
        if p14.Transparency < 0.95 then return false end
        return not p14.CanCollide and p14.Name ~= "Head"
    end
    GunUtil.Block = function(p15, p16, p17)
        local delta = p17 - p16
        if delta.Magnitude < 0.5 then return nil end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local filter = { p15 }
        for _ = 1, 8 do
            params.FilterDescendantsInstances = filter
            local hit = workspace:Raycast(p16, delta, params)
            if not hit then return nil end
            if not ignorable(hit.Instance) then
                if (hit.Position - p17).Magnitude <= 1.5 then return nil end
                return hit
            end
            table.insert(filter, hit.Instance)
        end
        return nil
    end
    GunUtil.Muzzle = function(p21)
        if not p21 then return nil end
        local root = p21:FindFirstChild("HumanoidRootPart")
        if root then
            return root.Position + Vector3.new(0, root.Size.Y * 0.5, 0)
        end
        return nil
    end
    S.GunUtil = GunUtil
end

do -- movement controls
    local Players, UIS, RunService, Workspace = S.Players, S.UIS, S.RunService, S.Workspace
    local LocalPlayer = S.LocalPlayer
    local movementCharacter, movementHumanoid, movementRoot
    local bodyVelocity, bodyGyro
    local savedAutoRotate, savedPlatformStand, movementStateCaptured = nil, nil, false
    local spinAccum = 0

    local function destroyFlightMovers()
        if bodyVelocity then pcall(function() bodyVelocity:Destroy() end); bodyVelocity = nil end
        if bodyGyro then pcall(function() bodyGyro:Destroy() end); bodyGyro = nil end
    end

    local function restoreHumanoidState()
        if movementHumanoid and movementStateCaptured then
            pcall(function() movementHumanoid.AutoRotate = savedAutoRotate end)
            pcall(function() movementHumanoid.PlatformStand = savedPlatformStand end)
        end
        savedAutoRotate, savedPlatformStand, movementStateCaptured = nil, nil, false
    end

    local function applyHumanoidState()
        local humanoid = movementHumanoid
        if not humanoid then return end
        local active = S.flightEnabled
        if active and not movementStateCaptured then
            savedAutoRotate = humanoid.AutoRotate
            savedPlatformStand = humanoid.PlatformStand
            movementStateCaptured = true
        end
        if active then
            pcall(function() humanoid.AutoRotate = false end)
            if S.flightEnabled then
                pcall(function() humanoid.PlatformStand = true end)
            end
        else
            restoreHumanoidState()
        end
    end

    local function findMovementRoot(character)
        if not character then return nil end
        local root = character:FindFirstChild("RootPart")
        if root and root:IsA("BasePart") then return root end
        root = character:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then return root end
        if character.PrimaryPart and character.PrimaryPart:IsA("BasePart") then return character.PrimaryPart end
        return nil
    end

    local function bindCharacter(character)
        if character == movementCharacter then return end
        destroyFlightMovers()
        restoreHumanoidState()
        movementCharacter = character
        movementHumanoid = character and character:FindFirstChildOfClass("Humanoid") or nil
        movementRoot = findMovementRoot(character)
        movementStateCaptured = false
        applyHumanoidState()
    end

    local function ensureCharacter()
        local character = LocalPlayer.Character
        if character ~= movementCharacter then bindCharacter(character) end
        if movementCharacter and (not movementHumanoid or not movementRoot) then
            movementHumanoid = movementCharacter:FindFirstChildOfClass("Humanoid") or movementHumanoid
            movementRoot = findMovementRoot(movementCharacter) or movementRoot
            applyHumanoidState()
        end
    end

    local function ensureFlightMovers()
        if not movementRoot or not movementRoot.Parent then return false end
        if not bodyVelocity or bodyVelocity.Parent ~= movementRoot then
            destroyFlightMovers()
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name = "SyntaxAimESP_FlightVelocity"
            bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bodyVelocity.P = 9e4
            bodyVelocity.Velocity = Vector3.zero
            bodyVelocity.Parent = movementRoot
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.Name = "SyntaxAimESP_FlightGyro"
            bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bodyGyro.P = 9e4
            bodyGyro.D = 1e3
            bodyGyro.CFrame = movementRoot.CFrame
            bodyGyro.Parent = movementRoot
        end
        return true
    end

    local function keyDown(key)
        local ok, down = pcall(function() return UIS:IsKeyDown(key) end)
        return ok and down
    end

    local function movementInput()
        if UIS:GetFocusedTextBox() then return Vector3.zero end
        local forward = (keyDown(Enum.KeyCode.W) and 1 or 0) - (keyDown(Enum.KeyCode.S) and 1 or 0)
        local side = (keyDown(Enum.KeyCode.D) and 1 or 0) - (keyDown(Enum.KeyCode.A) and 1 or 0)
        local vertical = ((keyDown(Enum.KeyCode.Space) or keyDown(Enum.KeyCode.E)) and 1 or 0)
            - ((keyDown(Enum.KeyCode.LeftControl) or keyDown(Enum.KeyCode.Q)) and 1 or 0)
        local camera = Workspace.CurrentCamera
        if not camera then return Vector3.zero end
        local direction = camera.CFrame.LookVector * forward + camera.CFrame.RightVector * side + Vector3.new(0, vertical, 0)
        if direction.Magnitude > 1 then direction = direction.Unit end
        return direction
    end

    local function setFlight(enabled)
        S.flightEnabled = enabled == true
        if not S.flightEnabled then destroyFlightMovers() end
        ensureCharacter()
        applyHumanoidState()
    end

    local function setSpinbot(enabled)
        local nextValue = enabled == true
        if nextValue and not S.spinbotEnabled then
            ensureCharacter()
            spinAccum = 0
        end
        S.spinbotEnabled = nextValue
        applyHumanoidState()
    end

    S.setFlight = setFlight
    S.setSpinbot = setSpinbot

    S.stopMovement = function()
        S.flightEnabled = false
        S.spinbotEnabled = false
        destroyFlightMovers()
        restoreHumanoidState()
        movementCharacter, movementHumanoid, movementRoot = nil, nil, nil
    end

    S.track(LocalPlayer.CharacterAdded:Connect(function(character)
        bindCharacter(character)
        applyHumanoidState()
    end))
    S.track(LocalPlayer.CharacterRemoving:Connect(function(character)
        if character == movementCharacter then
            destroyFlightMovers()
            restoreHumanoidState()
            movementCharacter, movementHumanoid, movementRoot = nil, nil, nil
            movementStateCaptured = false
        end
    end))

    S.track(RunService.RenderStepped:Connect(function(dt)
        if S.destroying then return end
        ensureCharacter()
        applyHumanoidState()
        local root = movementRoot
        if not root or not root.Parent then return end

        if S.flightEnabled and ensureFlightMovers() then
            bodyVelocity.Velocity = movementInput() * math.clamp(tonumber(S.flightSpeed) or 70, 10, 300)
            local camera = Workspace.CurrentCamera
            if camera then
                local look = camera.CFrame.LookVector
                local cameraYaw = math.atan2(-look.X, -look.Z)
                local yaw = cameraYaw
                bodyGyro.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
            end
        elseif not S.flightEnabled then
            destroyFlightMovers()
        end

        if S.spinbotEnabled then
            spinAccum = spinAccum + (tonumber(S.spinbotSpeed) or 12) * dt
            if movementHumanoid then
                local cf = root.CFrame
                pcall(function()
                    root.CFrame = CFrame.new(cf.Position) * CFrame.Angles(0, spinAccum, 0)
                end)
            end
        end
    end))
end

do -- weapon mods UI
    local MiscPage = S.MiscPage
    local applyAll = S.applyAll
    local ModsSection = MiscPage:Section({ Name = "Weapon Mods", Side = "Left" })
    ModsSection:Toggle({ Name = "No Recoil", Flag = "weapon_norecoil", Default = false, Callback = function(v)
        S.weaponNoRecoil = v; applyAll()
    end })
    ModsSection:Toggle({ Name = "No Spread / Bloom", Flag = "weapon_nospread", Default = false, Callback = function(v)
        S.weaponNoSpread = v; applyAll()
    end })
    ModsSection:Toggle({ Name = "No Falloff", Flag = "weapon_nofalloff", Default = false, Callback = function(v)
        S.weaponNoFalloff = v; applyAll()
    end })
    ModsSection:Toggle({ Name = "No Reload Per Shell", Flag = "weapon_noshellreload", Default = false, Callback = function(v)
        S.weaponNoReloadPerShell = v; applyAll()
    end })
    ModsSection:Toggle({ Name = "Range Mod", Flag = "weapon_rangemod", Default = false, Callback = function(v)
        S.weaponRangeMod = v; applyAll()
    end })
    ModsSection:Slider({ Name = "Range Value", Min = 50, Max = 5000, Default = 1500, Flag = "weapon_range_val",
        Callback = function(v) S.weaponRangeValue = tonumber(v) or S.weaponRangeValue; applyAll() end })
    ModsSection:Toggle({ Name = "Rapid Fire", Flag = "weapon_rapidfire", Default = false, Callback = function(v)
        S.weaponRapidFire = v; applyAll()
    end })
    ModsSection:Slider({ Name = "Fire Rate Delay", Min = 0.08, Max = 1, Default = 0.12, Decimals = 2, Flag = "weapon_rapidfire_val",
        Callback = function(v) S.weaponRapidFireValue = tonumber(v) or S.weaponRapidFireValue; applyAll() end })
    ModsSection:Toggle({ Name = "Instant Reload", Flag = "weapon_instantreload", Default = false, Callback = function(v)
        S.weaponInstantReload = v; applyAll()
    end })
    ModsSection:Slider({ Name = "Reload Time", Min = 0.15, Max = 5, Default = 0.15, Decimals = 2, Flag = "weapon_reload_val",
        Callback = function(v) S.weaponReloadValue = tonumber(v) or S.weaponReloadValue; applyAll() end })
    ModsSection:Toggle({ Name = "Hitscan", Flag = "weapon_hitscan", Default = false, Callback = function(v)
        S.weaponHitscan = v
    end })
    ModsSection:Toggle({ Name = "Debug", Flag = "weapon_debug", Default = false, Callback = function(v)
        S.weaponDebug = v
    end })

    local MovementSection = S.MovementPage:Section({ Name = "Controls", Side = "Left" })
    MovementSection:Toggle({ Name = "Flight (WASD + Space/Ctrl)", Flag = "movement_flight", Default = false, Callback = function(v)
        S.setFlight(v)
    end })
    MovementSection:Keybind({
        Name = "Flight Keybind",
        Flag = "movement_flight_key",
        Default = Enum.KeyCode.F,
        Mode = "Always",
        ChangedCallback = function(k)
            if k then S.flightKey = k end
        end
    })
    MovementSection:Slider({ Name = "Flight Speed", Min = 10, Max = 300, Default = 70, Flag = "movement_flight_speed", Callback = function(v)
        S.flightSpeed = math.clamp(tonumber(v) or S.flightSpeed, 10, 300)
    end })
    MovementSection:Toggle({ Name = "Spinbot", Flag = "movement_spinbot", Default = false, Callback = function(v)
        S.setSpinbot(v)
    end })
    MovementSection:Slider({ Name = "Spin Speed", Min = 2, Max = 60, Default = 12, Flag = "movement_spin_speed", Callback = function(v)
        S.spinbotSpeed = math.clamp(tonumber(v) or S.spinbotSpeed, 2, 60)
    end })

    S.track(S.UIS.InputBegan:Connect(function(input, gp)
        if gp or S.UIS:GetFocusedTextBox() then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == S.flightKey then
            S.setFlight(not S.flightEnabled)
        end
    end))

    local BulletSection = MiscPage:Section({ Name = "Bullet Mods", Side = "Right" })
    BulletSection:Toggle({ Name = "Magic Bullet", Flag = "bullet_magic", Default = false, Callback = function(v) S.magicBulletEnabled = v end })
    BulletSection:Slider({ Name = "Bullet FOV", Min = 1, Max = 1000, Default = 150, Flag = "bullet_fov", Callback = function(v) S.bulletModsFOV = tonumber(v) or S.bulletModsFOV end })
    BulletSection:Slider({ Name = "Bullet Range", Min = 10, Max = 5000, Default = 500, Flag = "bullet_range", Callback = function(v) S.bulletModsRange = tonumber(v) or S.bulletModsRange end })
    BulletSection:Dropdown({ Name = "Target Part", Flag = "bullet_part", Options = { "HeadHitbox", "Head", "HumanoidRootPart" }, Default = "HeadHitbox", Callback = function(v) S.bulletModsPart = v end })
    BulletSection:Toggle({ Name = "Debug", Flag = "bullet_debug", Default = false, Callback = function(v) S.bulletModsDebug = v end })

    local CameraSection = MiscPage:Section({ Name = "Camera", Side = "Right" })
    CameraSection:Toggle({ Name = "FOV Changer", Flag = "camera_fov_enabled", Default = false, Callback = function(v)
        S.fovChangerEnabled = v
        local cam = S.getCamera()
        if v then
            S.fovCamera = cam
            if cam then S.fovOriginal = cam.FieldOfView end
        else
            local restoreCamera = S.fovCamera
            if restoreCamera and S.fovOriginal then pcall(function() restoreCamera.FieldOfView = S.fovOriginal end) end
            S.fovOriginal = nil; S.fovCamera = nil
        end
    end })
    CameraSection:Slider({ Name = "Camera FOV", Min = 30, Max = 120, Default = 90, Flag = "camera_fov_value",
        Callback = function(v) S.targetCameraFOV = math.clamp(tonumber(v) or 90, 30, 120) end })

    local ZoomSection = MiscPage:Section({ Name = "Zoom", Side = "Right" })
    ZoomSection:Toggle({ Name = "Zoom Enabled", Flag = "zoom_enabled", Default = false, Callback = function(v) S.zoomEnabled = v end })
    ZoomSection:Slider({ Name = "Zoom FOV", Min = 10, Max = 80, Default = 30, Flag = "zoom_fov", Callback = function(v) S.zoomFOV = math.clamp(tonumber(v) or 30, 10, 80) end })
    ZoomSection:Keybind({ Name = "Zoom Key", Flag = "zoom_key", Default = Enum.KeyCode.Z, Mode = "Always", ChangedCallback = function(k) S.zoomKey = k end })

    S.track(S.RunService.RenderStepped:Connect(function()
        if S.destroying then return end
        local cam = S.Workspace.CurrentCamera
        if not cam then return end

        local zoomHeld = S.zoomEnabled and S.zoomKey and S.UIS:IsKeyDown(S.zoomKey) and not S.UIS:GetFocusedTextBox()
        S.zoomActive = zoomHeld

        if zoomHeld then
            if math.abs(cam.FieldOfView - S.zoomFOV) > 0.01 then
                cam.FieldOfView = S.zoomFOV
            end
        elseif S.fovChangerEnabled then
            if cam ~= S.fovCamera then
                local prev = S.fovCamera
                if prev and S.fovOriginal then pcall(function() prev.FieldOfView = S.fovOriginal end) end
                S.fovCamera = cam
                S.fovOriginal = cam.FieldOfView
            end
            if not S.fovOriginal then S.fovOriginal = cam.FieldOfView end
            if math.abs(cam.FieldOfView - S.targetCameraFOV) > 0.01 then cam.FieldOfView = S.targetCameraFOV end
        elseif S.zoomEnabled and not zoomHeld and S.fovCamera and S.fovOriginal then
            if math.abs(cam.FieldOfView - S.fovOriginal) > 0.01 then
                cam.FieldOfView = S.fovOriginal
            end
        end
    end))
end

do -- ESP setup & connection wiring
    local Players = S.Players
    local espGuiName = "SyntaxAimESP_ESP"
    local oldEspGui = gethui():FindFirstChild(espGuiName)
    if oldEspGui then oldEspGui:Destroy() end
    local espGui = Instance.new("ScreenGui")
    espGui.Name = espGuiName
    espGui.IgnoreGuiInset = true
    espGui.ResetOnSpawn = false
    espGui.DisplayOrder = 10
    espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() espGui.ClipToDeviceSafeArea = false end)
    pcall(function() espGui.ScreenInsets = Enum.ScreenInsets.None end)
    espGui.Parent = gethui()
    S.espGui = espGui
    -- protect from basic CoreGui scans when streamproof later reparents
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(espGui) end
    end)
    pcall(function()
        if gethui and protect_gui then protect_gui(espGui) end
    end)
    S.playerData = {}
    S.partCache = {}
    S.charCacheConn = {}
    S.visibilityCache = {}
    S.espEnabled = false
    S.boxEnabled = false
    S.nameEnabled = false
    S.distanceEnabled = false
    S.healthEnabled = false
    S.shieldEnabled = false
    S.weaponEnabled = false
    S.maxDistance = 1000
    S.boxBounds = "Default"
    S.boxColor = Color3.fromRGB(255, 255, 255)
    S.nameColor = Color3.fromRGB(255, 255, 255)
    S.distanceColor = Color3.fromRGB(255, 255, 255)
    S.healthTextColor = Color3.fromRGB(255, 255, 255)
    S.healthBarColor = Color3.fromRGB(0, 255, 0)
    S.shieldTextColor = Color3.fromRGB(0, 150, 255)
    S.shieldBarColor = Color3.fromRGB(0, 150, 255)
    S.weaponColor = Color3.fromRGB(97, 97, 97)
    S.snaplineEnabled = false
    S.snaplineFrom = "Bottom"
    S.snaplineColor = Color3.fromRGB(255, 255, 255)
    S.TracerThickness = 1.5
    S.TracerTransparency = 0.5
    S.visibleColor = Color3.fromRGB(0, 255, 0)
    S.hiddenColor = Color3.fromRGB(255, 0, 0)
    S.filledBox = false
    S.espVisColors = false
    S.targetHighlightElement = { "Box", "Snapline", "Filled Box", "Name" }
    S.healthDisplayMode = "bar"
    S.healthPosition = "left"
    S.shieldDisplayMode = "bar"
    S.shieldPosition = "left"

    local function hideESPData(data)
        if not data then return end
        for _, k in ipairs({ "fullFrame","fillFrame","snapline","nameLabel","healthBar","sideHealthText",
            "topHealthText","bottomHealthText","shieldBar","sideShieldText","topShieldText","bottomShieldText",
            "weaponLabel","distanceLabel","knockedLabel","killsLabel","arrowFrame" }) do
            if data[k] then data[k].Visible = false end
        end
        if data.skeletonLines then
            for _, line in ipairs(data.skeletonLines) do line.Visible = false end
        end
    end
    S.hideESPData = hideESPData

    local function cleanupPlayerESP(player)
        local data = S.playerData[player]
        if data then
            for _, key in ipairs({ "fullFrame","fillFrame","nameLabel","healthBar","sideHealthText",
                "topHealthText","bottomHealthText","shieldBar","sideShieldText","topShieldText",
                "bottomShieldText","weaponLabel","distanceLabel","knockedLabel","killsLabel","arrowFrame" }) do
                if data[key] then pcall(function() data[key]:Destroy() end) end
            end
            if data.snapline then pcall(function() data.snapline:Destroy() end) end
            S.playerData[player] = nil
        end
        local char = player and (player.Character or player)
        if typeof(char) == "Instance" then
            S.partCache[char] = nil
            S.visibilityCache[char] = nil
            if S.charCacheConn[char] then pcall(function() S.charCacheConn[char]:Disconnect() end); S.charCacheConn[char] = nil end
        end
    end
    S.cleanupPlayerESP = cleanupPlayerESP

    for _, player in ipairs(Players:GetPlayers()) do
        S.track(player.CharacterRemoving:Connect(function(char)
            S.partCache[char] = nil; S.visibilityCache[char] = nil
            if S.charCacheConn[char] then pcall(function() S.charCacheConn[char]:Disconnect() end); S.charCacheConn[char] = nil end
            hideESPData(S.playerData[player])
        end))
        S.track(player.CharacterAdded:Connect(function(char)
            S.partCache[char] = nil; S.visibilityCache[char] = nil
            if S.charCacheConn[char] then pcall(function() S.charCacheConn[char]:Disconnect() end); S.charCacheConn[char] = nil end
            hideESPData(S.playerData[player])
        end))
    end
    S.track(Players.PlayerAdded:Connect(function(player)
        S.track(player.CharacterRemoving:Connect(function(char)
            S.partCache[char] = nil; S.visibilityCache[char] = nil
            if S.charCacheConn[char] then pcall(function() S.charCacheConn[char]:Disconnect() end); S.charCacheConn[char] = nil end
            hideESPData(S.playerData[player])
        end))
        S.track(player.CharacterAdded:Connect(function(char)
            S.partCache[char] = nil; S.visibilityCache[char] = nil
            if S.charCacheConn[char] then pcall(function() S.charCacheConn[char]:Disconnect() end); S.charCacheConn[char] = nil end
            hideESPData(S.playerData[player])
        end))
    end))
    S.track(Players.PlayerRemoving:Connect(function(player) cleanupPlayerESP(player) end))
end

