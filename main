        if not S.silentEnabled then S.memoryTarget = nil; S.silentTarget = nil end
    end })
    AimSection:Toggle({ Name = "Memory Aim", Flag = "memory_aim", Default = false, Callback = function(v)
        S.memoryAim = v == true
        if not S.memoryAim then S.memoryTarget = nil end
