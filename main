do -- radar
    local Players, RunService = S.Players, S.RunService
    local LocalPlayer = S.LocalPlayer
    local radarGui, radarFrame = nil, nil
    local radarBlips, radarRingLabels = {}, {}
    local radarDragConns = {}
    local radarDragging = false
    local smoothedRange = S.radarRenderDistance

    local function destroyRadar()
        for _, conn in ipairs(radarDragConns) do pcall(function() conn:Disconnect() end) end
        radarDragConns = {}
        radarDragging = false
        if radarGui then pcall(function() radarGui:Destroy() end) end
        radarGui = nil
        radarFrame = nil
        radarBlips = {}
        radarRingLabels = {}
    end
    S.destroyRadar = destroyRadar

    local function createRadarGui()
        if radarGui then return end
        local oldRadar = gethui():FindFirstChild("SyntaxAimESP_Radar")
        if oldRadar then pcall(function() oldRadar:Destroy() end) end
        radarGui = Instance.new("ScreenGui")
        radarGui.Name = "SyntaxAimESP_Radar"
        radarGui.IgnoreGuiInset = true
        radarGui.ResetOnSpawn = false
        radarGui.DisplayOrder = 5
        radarGui.Parent = gethui()

        local frame = Instance.new("Frame")
        frame.Name = "Radar"
        frame.AnchorPoint = Vector2.new(0.5, 0.5)
        frame.Position = UDim2.new(1, -(S.radarRenderRadius + 24) + S.radarDragOffset.X, 0.5, S.radarDragOffset.Y)
        frame.Size = UDim2.fromOffset(S.radarRenderRadius * 2, S.radarRenderRadius * 2)
        frame.BackgroundColor3 = S.radarBackgroundColor
        frame.BackgroundTransparency = 1 - S.radarBackgroundAlpha
        frame.BorderSizePixel = 0
        frame.ClipsDescendants = false
        frame.Active = true
        frame.Parent = radarGui
        radarFrame = frame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = frame
        local border = Instance.new("UIStroke")
        border.Name = "Border"
        border.Color = Color3.fromRGB(120, 120, 130)
        border.Thickness = 1
        border.Transparency = 0.35
        border.Parent = frame

        for i = 1, 3 do
            local ring = Instance.new("Frame")
            ring.Name = "Ring" .. i
            ring.AnchorPoint = Vector2.new(0.5, 0.5)
            ring.Position = UDim2.fromScale(0.5, 0.5)
            ring.Size = UDim2.fromScale(i / 3, i / 3)
            ring.BackgroundTransparency = 1
            ring.BorderSizePixel = 0
            ring.Parent = frame
            local rc = Instance.new("UICorner")
            rc.CornerRadius = UDim.new(0.5, 0)
            rc.Parent = ring
            local rs = Instance.new("UIStroke")
            rs.Color = Color3.fromRGB(255, 255, 255)
            rs.Thickness = 1
            rs.Transparency = 0.82
            rs.Parent = ring
            local label = Instance.new("TextLabel")
            label.Name = "Label"
            label.AnchorPoint = Vector2.new(0.5, 1)
            label.Position = UDim2.fromScale(0.5, 0)
            label.Size = UDim2.fromOffset(54, 12)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.TextSize = 10
            label.TextColor3 = Color3.fromRGB(225, 225, 225)
            label.TextTransparency = 0.25
            label.Text = ""
            label.Visible = false
            label.Parent = ring
            radarRingLabels[i] = label
        end

        local hLine = Instance.new("Frame")
        hLine.Name = "Horizontal"
        hLine.AnchorPoint = Vector2.new(0.5, 0.5)
        hLine.Position = UDim2.fromScale(0.5, 0.5)
        hLine.Size = UDim2.new(1, 0, 0, 1)
        hLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        hLine.BackgroundTransparency = 0.85
        hLine.BorderSizePixel = 0
        hLine.Parent = frame
        local vLine = Instance.new("Frame")
        vLine.Name = "Vertical"
        vLine.AnchorPoint = Vector2.new(0.5, 0.5)
        vLine.Position = UDim2.fromScale(0.5, 0.5)
        vLine.Size = UDim2.new(0, 1, 1, 0)
        vLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        vLine.BackgroundTransparency = 0.85
        vLine.BorderSizePixel = 0
        vLine.Parent = frame

        local selfDot = Instance.new("Frame")
        selfDot.Name = "Self"
        selfDot.AnchorPoint = Vector2.new(0.5, 0.5)
        selfDot.Position = UDim2.fromScale(0.5, 0.5)
        selfDot.Size = UDim2.fromOffset(6, 6)
        selfDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        selfDot.BorderSizePixel = 0
        selfDot.Parent = frame
        local sc = Instance.new("UICorner")
        sc.CornerRadius = UDim.new(1, 0)
        sc.Parent = selfDot

        local dragStartInput, dragStartOffset = nil, S.radarDragOffset
        radarDragConns[#radarDragConns + 1] = frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                radarDragging = true
                dragStartInput = input.Position
                dragStartOffset = S.radarDragOffset
            end
        end)
        radarDragConns[#radarDragConns + 1] = frame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                radarDragging = false
            end
        end)
        radarDragConns[#radarDragConns + 1] = S.UIS.InputChanged:Connect(function(input)
            if not radarDragging or not radarFrame then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStartInput
                S.radarDragOffset = Vector2.new(dragStartOffset.X + delta.X, dragStartOffset.Y + delta.Y)
                radarFrame.Position = UDim2.new(1, -(S.radarRenderRadius + 24) + S.radarDragOffset.X, 0.5, S.radarDragOffset.Y)
            end
        end)
    end

    local function getOrCreateBlip(key)
        local blip = radarBlips[key]
        if blip and blip.Parent then return blip end
        if not radarFrame then return nil end
        blip = Instance.new("Frame")
        blip.Name = "Blip"
        blip.AnchorPoint = Vector2.new(0.5, 0.5)
        blip.Size = UDim2.fromOffset(S.radarPlayerSize, S.radarPlayerSize)
        blip.BackgroundColor3 = S.radarEnemyColor
        blip.BorderSizePixel = 0
        blip.Visible = false
        blip.Parent = radarFrame
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = blip
        local distLabel = Instance.new("TextLabel")
        distLabel.Name = "Dist"
        distLabel.AnchorPoint = Vector2.new(0.5, 0)
        distLabel.Position = UDim2.new(0.5, 0, 1, 1)
        distLabel.Size = UDim2.fromOffset(40, 10)
        distLabel.BackgroundTransparency = 1
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 9
        distLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        distLabel.Text = ""
        distLabel.Visible = false
        distLabel.Parent = blip
        radarBlips[key] = blip
        return blip
    end

    local function updateRadar()
        if S.destroying or not S.radarEnabled then
            if radarGui then destroyRadar() end
            return
        end
        if not radarGui then createRadarGui() end
        if not radarFrame then return end

        local radius = math.clamp(tonumber(S.radarRenderRadius) or 150, 60, 400)
        radarFrame.Size = UDim2.fromOffset(radius * 2, radius * 2)
        radarFrame.BackgroundColor3 = S.radarBackgroundColor
        radarFrame.BackgroundTransparency = 1 - (tonumber(S.radarBackgroundAlpha) or 0.35)
        radarFrame.Position = UDim2.new(1, -(radius + 24) + S.radarDragOffset.X, 0.5, S.radarDragOffset.Y)

        local localChar = LocalPlayer.Character
        local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("RootPart"))
        if not localRoot then
            for _, b in pairs(radarBlips) do b.Visible = false end
            return
        end

        local cam = S.getCamera()
        local look = cam and cam.CFrame.LookVector or localRoot.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
        local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

        local maxDist = 0
        local entries = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("RootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local delta = root.Position - localRoot.Position
                    local dist = delta.Magnitude
                    maxDist = math.max(maxDist, dist)
                    entries[#entries + 1] = { key = player, root = root, delta = delta, dist = dist, team = player.Team == LocalPlayer.Team }
                end
            end
        end

        local targetRange = tonumber(S.radarRenderDistance) or 300
        if S.radarAutoScale and maxDist > 0 then
            targetRange = math.clamp(maxDist * 1.15, 40, 2000)
        end
        smoothedRange = smoothedRange + (targetRange - smoothedRange) * 0.08
        local effectiveRange = math.max(smoothedRange, 25)

        if S.radarDistanceVisualizer then
            for i = 1, 3 do
                local label = radarRingLabels[i]
                if label then
                    label.Text = string.format("%.0fm", effectiveRange * (i / 3))
                    label.Visible = true
                end
            end
        else
            for i = 1, 3 do
                if radarRingLabels[i] then radarRingLabels[i].Visible = false end
            end
        end

        local seen = {}
        for _, e in ipairs(entries) do
            seen[e.key] = true
            local blip = getOrCreateBlip(e.key)
            if blip then
                local scale = math.clamp(e.dist / effectiveRange, 0, 1)
                local x, y
                if S.radarOrientationLock then
                    local right = e.delta:Dot(flatRight)
                    local forward = e.delta:Dot(flatLook)
                    x = (right / effectiveRange) * radius
                    y = (-forward / effectiveRange) * radius
                else
                    x = (e.delta.X / effectiveRange) * radius
                    y = (e.delta.Z / effectiveRange) * radius
                end
                local mag = math.sqrt(x * x + y * y)
                if mag > radius - 2 then
                    local f = (radius - 2) / mag
                    x, y = x * f, y * f
                end
                blip.Position = UDim2.fromOffset(radius + x, radius + y)
                blip.Size = UDim2.fromOffset(S.radarPlayerSize, S.radarPlayerSize)
                local col = (S.radarTeamVisualizer and e.team) and S.radarTeamColor or S.radarEnemyColor
                blip.BackgroundColor3 = col
                blip.Visible = true
                local distLabel = blip:FindFirstChild("Dist")
                if distLabel then
                    if S.radarDistanceVisualizer then
                        distLabel.Text = string.format("%.0f", e.dist)
                        distLabel.Visible = true
                    else
                        distLabel.Visible = false
                    end
                end
            end
        end
        for key, blip in pairs(radarBlips) do
            if not seen[key] then blip.Visible = false end
        end
    end

    S.track(RunService.RenderStepped:Connect(function()
        if S.destroying then return end
        updateRadar()
    end))

    local RadarPage = S.RadarPage
    local RadarSection = RadarPage:Section({ Name = "Radar", Side = "Left" })
    local RadarAppearance = RadarPage:Section({ Name = "Appearance", Side = "Right" })
    RadarSection:Toggle({ Name = "Radar Enabled", Flag = "radar_enabled", Default = false, Callback = function(value)
        S.radarEnabled = value
        if not value then destroyRadar() end
    end })
    RadarSection:Toggle({ Name = "Radar Automatic Distance Scaling", Flag = "radar_auto_scale", Default = true, Callback = function(value) S.radarAutoScale = value end })
    RadarSection:Toggle({ Name = "Radar Orientation Lock", Flag = "radar_orientation_lock", Default = true, Callback = function(value) S.radarOrientationLock = value end })
    RadarSection:Slider({ Name = "Radar Render Radius", Flag = "radar_render_radius", Min = 60, Max = 400, Default = 150, Callback = function(value) S.radarRenderRadius = tonumber(value) or S.radarRenderRadius end })
    RadarSection:Slider({ Name = "Radar Render Distance", Flag = "radar_render_distance", Min = 25, Max = 2000, Default = 300, Callback = function(value) S.radarRenderDistance = tonumber(value) or S.radarRenderDistance end })
    RadarSection:Slider({ Name = "Radar Player Size", Flag = "radar_player_size", Min = 2, Max = 16, Default = 6, Callback = function(value) S.radarPlayerSize = tonumber(value) or S.radarPlayerSize end })
    RadarSection:Slider({ Name = "Radar Background Alpha", Flag = "radar_background_alpha", Min = 0, Max = 1, Default = 0.35, Decimals = 2, Callback = function(value) S.radarBackgroundAlpha = tonumber(value) or S.radarBackgroundAlpha end })
    RadarAppearance:Toggle({ Name = "Radar Team Visualizer", Flag = "radar_team_visualizer", Default = true, Callback = function(value) S.radarTeamVisualizer = value end })
    RadarAppearance:Toggle({ Name = "Radar Distance Visualizer", Flag = "radar_distance_visualizer", Default = true, Callback = function(value) S.radarDistanceVisualizer = value end })
    RadarAppearance:Colorpicker({ Name = "Radar Background Color", Flag = "radar_background_color", Default = S.radarBackgroundColor, Callback = function(value) if typeof(value) == "Color3" then S.radarBackgroundColor = value end end })
    RadarAppearance:Colorpicker({ Name = "Radar Enemy Color", Flag = "radar_enemy_color", Default = S.radarEnemyColor, Callback = function(value) if typeof(value) == "Color3" then S.radarEnemyColor = value end end })
    RadarAppearance:Colorpicker({ Name = "Radar Team Color", Flag = "radar_team_color", Default = S.radarTeamColor, Callback = function(value) if typeof(value) == "Color3" then S.radarTeamColor = value end end })
end

do -- ESP drawing helpers
    local espGui = S.espGui
    S.BOUNDING_CORNERS = {
        Vector3.new(1, 1, 1), Vector3.new(1, 1, -1), Vector3.new(1, -1, 1), Vector3.new(1, -1, -1),
        Vector3.new(-1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, -1, -1)
    }
    S.KNOCKED_ATTRS = {
        "Knocked", "IsKnocked", "KnockedOut", "IsKnockedOut", "Downed", "IsDowned",
        "Down", "IsDown", "DBNO", "IsDBNO", "Incapacitated", "IsIncapacitated"
    }

    S.createFullBox = function(player)
        local frame = Instance.new("Frame")
        frame.Name = player.Name .. "_FullBox"
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0
        frame.Size = UDim2.new(0, 0, 0, 0)
        frame.Position = UDim2.new(0, 0, 0, 0)
        frame.Visible = false
        frame.Parent = espGui
        local stroke = Instance.new("UIStroke")
        stroke.Name = "UIStroke"
        stroke.Color = S.boxColor
        stroke.Thickness = 1
        stroke.BorderStrokePosition = Enum.BorderStrokePosition.Inner
        stroke.Transparency = 0
        stroke.Parent = frame
        local outline = Instance.new("UIStroke")
        outline.Name = "UIStrokeOutline"
        outline.Color = Color3.fromRGB(0, 0, 0)
        outline.Thickness = 1
        outline.ZIndex = -1
        outline.BorderStrokePosition = Enum.BorderStrokePosition.Outer
        outline.Transparency = 0
        outline.Parent = frame
        return frame
    end

    S.createFillBox = function(player)
        local frame = Instance.new("Frame")
        frame.Name = player.Name .. "_FillBox"
        frame.BackgroundColor3 = S.boxColor
        frame.BackgroundTransparency = 0.75
        frame.BorderSizePixel = 0
        frame.Size = UDim2.new(0, 0, 0, 0)
        frame.Position = UDim2.new(0, 0, 0, 0)
        frame.Visible = false
        frame.ZIndex = 0
        frame.Parent = espGui
        return frame
    end

    S.createSnapline = function(player)
        local line = Instance.new("Frame")
        line.Name = player.Name .. "_Snapline"
        line.BackgroundColor3 = S.snaplineColor
        line.BackgroundTransparency = S.TracerTransparency
        line.BorderSizePixel = 0
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Size = UDim2.new(0, 0, 0, S.TracerThickness)
        line.Position = UDim2.new(0, 0, 0, 0)
        line.Visible = false
        line.ZIndex = 1
        line.Parent = espGui
        return line
    end

    S.createTextLabel = function(player, name, text, color)
        local label = Instance.new("TextLabel")
        label.Name = player.Name .. "_" .. name
        label.BackgroundTransparency = 1
        label.Text = text or ""
        label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
        label.TextScaled = false
        label.TextSize = 12
        label.Size = UDim2.new(0, 200, 0, 12)
        label.Visible = false
        label.Parent = espGui
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextWrapped = false
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        return label
    end

    S.createBar = function(player, suffix, color)
        local bar = Instance.new("Frame")
        bar.Name = player.Name .. "_" .. suffix
        bar.BackgroundTransparency = 0.3
        bar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bar.BorderSizePixel = 0
        bar.Size = UDim2.new(0, 0, 0, 0)
        bar.Position = UDim2.new(0, 0, 0, 0)
        bar.Visible = false
        bar.Parent = espGui
        local stroke = Instance.new("UIStroke")
        stroke.Name = "UIStroke"
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.Thickness = 1
        stroke.BorderStrokePosition = Enum.BorderStrokePosition.Outer
        stroke.Transparency = 0
        stroke.Parent = bar
        local fill = Instance.new("Frame")
        fill.Name = "Fill"
        fill.BackgroundTransparency = 0
        fill.BackgroundColor3 = color
        fill.BorderSizePixel = 0
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.Parent = bar
        return bar, fill
    end

    S.createArrow = function(player)
        -- Text triangle is more reliable than a random rbxassetid
        local arrow = Instance.new("TextLabel")
        arrow.Name = player.Name .. "_Arrow"
        arrow.BackgroundTransparency = 1
        arrow.Text = "▲"
        arrow.Font = Enum.Font.SourceSansBold
        arrow.TextSize = S.arrowsSize
        arrow.TextColor3 = S.arrowsColor
        arrow.TextStrokeTransparency = 0
        arrow.TextStrokeColor3 = Color3.new(0, 0, 0)
        arrow.Size = UDim2.fromOffset(S.arrowsSize + 8, S.arrowsSize + 8)
        arrow.AnchorPoint = Vector2.new(0.5, 0.5)
        arrow.Visible = false
        arrow.ZIndex = 20
        arrow.Parent = espGui
        return arrow
    end

    S.isKnocked = function(character, humanoid)
        if not character then return false end
        for _, name in ipairs(S.KNOCKED_ATTRS) do
            local v = character:GetAttribute(name)
            if v == true or (type(v) == "number" and v > 0) then return true end
            if humanoid then
                v = humanoid:GetAttribute(name)
                if v == true or (type(v) == "number" and v > 0) then return true end
            end
        end
        for _, container in ipairs({ character, humanoid }) do
            if container then
                for _, name in ipairs(S.KNOCKED_ATTRS) do
                    local child = container:FindFirstChild(name)
                    if child and child:IsA("ValueBase") then
                        if child.Value == true or (type(child.Value) == "number" and child.Value > 0) then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    S.getCharacterBoundingBox = function(character)
        local cam = S.getCamera()
        if not character or not cam then return nil end
        local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
        local hasPoints = false

        if S.boxBounds == "Default" then
            local head = character:FindFirstChild("HeadHitbox") or character:FindFirstChild("Head")
            local root = character:FindFirstChild("RootPart") or character:FindFirstChild("HumanoidRootPart")
            if head and root and head:IsA("BasePart") and root:IsA("BasePart") then
                local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y * 0.5, 0))
                local rootPos = cam:WorldToViewportPoint(root.Position - Vector3.new(0, root.Size.Y * 0.5, 0))
                local centerPos = cam:WorldToViewportPoint(root.Position)
                if headPos.Z > 0 and rootPos.Z > 0 and centerPos.Z > 0 then
                    local topY = math.min(headPos.Y, rootPos.Y)
                    local bottomY = math.max(headPos.Y, rootPos.Y)
                    local height = math.max(bottomY - topY, 8)
                    local width = height * 0.55
                    minX = centerPos.X - (width * 0.5)
                    maxX = centerPos.X + (width * 0.5)
                    minY = topY
                    maxY = bottomY
                    hasPoints = true
                end
            end
            -- fallback if Default failed
            if not hasPoints then
                local parts = {}
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Transparency < 1 then
                        parts[#parts + 1] = part
                        if #parts >= 8 then break end
                    end
                end
                for _, part in ipairs(parts) do
                    local screenPos = cam:WorldToViewportPoint(part.Position)
                    if screenPos.Z > 0 then
                        minX = math.min(minX, screenPos.X)
                        maxX = math.max(maxX, screenPos.X)
                        minY = math.min(minY, screenPos.Y)
                        maxY = math.max(maxY, screenPos.Y)
                        hasPoints = true
                    end
                end
                if hasPoints then
                    local pad = 10
                    local h = math.max(maxY - minY, 12)
                    local w = math.max(maxX - minX, h * 0.4)
                    local cx = (minX + maxX) * 0.5
                    minX, maxX = cx - w * 0.5, cx + w * 0.5
                    minY, maxY = minY - pad * 0.2, maxY + pad * 0.2
                end
            end
        else
            local okBox, boxCF, boxSize = pcall(character.GetBoundingBox, character)
            if okBox and boxCF and boxSize then
                for _, corner in ipairs(S.BOUNDING_CORNERS) do
                    local worldPoint = boxCF * (corner * boxSize * 0.5)
                    local screenPos = cam:WorldToViewportPoint(worldPoint)
                    if screenPos.Z > 0 then
                        minX = math.min(minX, screenPos.X)
                        maxX = math.max(maxX, screenPos.X)
                        minY = math.min(minY, screenPos.Y)
                        maxY = math.max(maxY, screenPos.Y)
                        hasPoints = true
                    end
                end
            else
                local parts = S.partCache[character]
                if not parts then
                    parts = {}
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "RootPart" and part.Transparency < 1 then
                            table.insert(parts, part)
                        end
                    end
                    S.partCache[character] = parts
                    if S.charCacheConn[character] then pcall(function() S.charCacheConn[character]:Disconnect() end) end
                    S.charCacheConn[character] = character.DescendantAdded:Connect(function(part)
                        if part:IsA("BasePart") then S.partCache[character] = nil end
                    end)
                end
                for _, part in ipairs(parts) do
                    if part and part.Parent then
                        for _, corner in ipairs(S.BOUNDING_CORNERS) do
                            local worldPoint = part.CFrame * (corner * part.Size * 0.5)
                            local screenPos = cam:WorldToViewportPoint(worldPoint)
                            if screenPos.Z > 0 then
                                minX = math.min(minX, screenPos.X)
                                maxX = math.max(maxX, screenPos.X)
                                minY = math.min(minY, screenPos.Y)
                                maxY = math.max(maxY, screenPos.Y)
                                hasPoints = true
                            end
                        end
                    end
                end
            end
        end

        if not hasPoints then return nil end
        local padding = 6
        return {
            X = minX - padding,
            Y = minY - padding,
            Width = (maxX - minX) + padding * 2,
            Height = (maxY - minY) + padding * 2
        }
    end

    S.getDistance = function(player, localRoot)
        if not localRoot then return nil end
        local character = player and (player.Character or player)
        local targetRoot = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("RootPart"))
        if not targetRoot then return nil end
        return (localRoot.Position - targetRoot.Position).Magnitude
    end

    S.getLobbyChars = function()
        local out = {}
        local scene = S.Workspace:FindFirstChild("HavocLobbyScene")
        if not scene then return out end
        for _, child in ipairs(scene:GetChildren()) do
            if child:IsA("Model") and child.Name:match("^LobbyChar") then
                out[#out + 1] = child
            end
        end
        return out
    end

    S.isEntityVisible = function(character)
        local cam = S.getCamera()
        if not cam or not character then return false end
        local origin = cam.CFrame.Position
        local parts = {}
        local preferred = { "HeadHitbox", "Head", "HumanoidRootPart", "RootPart", "BodyHitbox" }
        for _, name in ipairs(preferred) do
            local p = character:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end
        if #parts == 0 then
            for _, d in ipairs(character:GetDescendants()) do
                if d:IsA("BasePart") then
                    parts[#parts + 1] = d
                    if #parts >= 3 then break end
                end
            end
        end
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { S.LocalPlayer.Character, character }
        rayParams.IgnoreWater = true
        for _, p in ipairs(parts) do
            local dir = p.Position - origin
            local hit = S.Workspace:Raycast(origin, dir, rayParams)
            if not hit then return true end
        end
        return false
    end

    S.isEntityVisibleCached = function(character)
        if not (S.espVisColors or S.silentVisibleCheck) then return true end
        local now = os.clock()
        local cached = S.visibilityCache[character]
        if cached and now - cached.time < 0.12 then return cached.visible end
        local visible = S.isEntityVisible(character)
        S.visibilityCache[character] = { visible = visible, time = now }
        return visible
    end

    S.getKills = function(key)
        if typeof(key) ~= "Instance" or not key:IsA("Player") then return nil end
        local ls = key:FindFirstChild("leaderstats")
        if not ls then return nil end
        local kills = ls:FindFirstChild("Kills") or ls:FindFirstChild("kills") or ls:FindFirstChild("Eliminations")
        if kills and kills:IsA("ValueBase") and type(kills.Value) == "number" then
            return kills.Value
        end
        return nil
    end
end

do -- ESP update loop
    local RunService = S.RunService
    local function updateESP()
        if S.destroying then return end
        if not S.espEnabled and not S.arrowsEnabled then
            for _, data in pairs(S.playerData) do S.hideESPData(data) end
            return
        end

        local limitDist = tonumber(S.maxDistance) or 1000
        local localChar = S.LocalPlayer.Character
        local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("RootPart"))
        local cam = S.getCamera()
        local entities = {}
        for _, p in ipairs(S.Players:GetPlayers()) do
            if p ~= S.LocalPlayer then
                entities[#entities + 1] = { key = p, character = p.Character, name = p.Name, isPlayer = true }
            end
        end
        for _, m in ipairs(S.getLobbyChars()) do
            entities[#entities + 1] = { key = m, character = m, name = m.Name, isPlayer = false }
        end

        local stale = {}
        for key, _ in pairs(S.playerData) do
            if typeof(key) == "Instance" and key:IsA("Model") and (not key.Parent) then
                stale[#stale + 1] = key
            end
        end
        for _, key in ipairs(stale) do S.cleanupPlayerESP(key) end

        for i = 1, #entities do
            local ent = entities[i]
            local key, character, displayName = ent.key, ent.character, ent.name
            if not character or not character.Parent then
                S.cleanupPlayerESP(key)
            else
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then
                    S.cleanupPlayerESP(key)
                else
                    local dist = S.getDistance(key, localRoot)
                    local offscreenOnly = false
                    local bbox = S.getCharacterBoundingBox(character)
                    if dist == nil or dist > limitDist then
                        S.hideESPData(S.playerData[key])
                    else
                        if not bbox then
                            -- still allow arrows when off-box
                            offscreenOnly = true
                        end

                        local data = S.playerData[key]
                        if not data then
                            local labelObj = { Name = displayName }
                            data = {}
                            data.fullFrame = S.createFullBox(labelObj)
                            data.fillFrame = S.createFillBox(labelObj)
                            data.snapline = S.createSnapline(labelObj)
                            data.nameLabel = S.createTextLabel(labelObj, "Name", displayName, S.nameColor)
                            data.topHealthText = S.createTextLabel(labelObj, "TopHealthText", "", S.healthTextColor)
                            data.bottomHealthText = S.createTextLabel(labelObj, "BottomHealthText", "", S.healthTextColor)
                            data.sideHealthText = S.createTextLabel(labelObj, "SideHealthText", "", S.healthTextColor)
                            data.topShieldText = S.createTextLabel(labelObj, "TopShieldText", "", S.shieldTextColor)
                            data.bottomShieldText = S.createTextLabel(labelObj, "BottomShieldText", "", S.shieldTextColor)
                            data.sideShieldText = S.createTextLabel(labelObj, "SideShieldText", "", S.shieldTextColor)
                            data.weaponLabel = S.createTextLabel(labelObj, "WeaponLabel", "", S.weaponColor)
                            data.distanceLabel = S.createTextLabel(labelObj, "Distance", "", S.distanceColor)
                            data.knockedLabel = S.createTextLabel(labelObj, "KnockedLabel", S.knockedText, S.knockedColor)
                            data.killsLabel = S.createTextLabel(labelObj, "KillsLabel", "", S.killsColor)
                            data.arrowFrame = S.createArrow(labelObj)
                            local hbar, hfill = S.createBar(labelObj, "HealthBar", S.healthBarColor)
                            data.healthBar = hbar
                            data.healthFill = hfill
                            local sbar, sfill = S.createBar(labelObj, "ShieldBar", S.shieldBarColor)
                            data.shieldBar = sbar
                            data.shieldFill = sfill
                            S.playerData[key] = data
                        end

                        S.hideESPData(data)

                        -- offscreen arrows
                        if S.arrowsEnabled and cam then
                            local rootPart = character:FindFirstChild("HumanoidRootPart")
                                or character:FindFirstChild("RootPart")
                                or character.PrimaryPart
                            if rootPart and data.arrowFrame then
                                local sp, onScreen = cam:WorldToViewportPoint(rootPart.Position)
                                local vp = cam.ViewportSize
                                local cx, cy = vp.X * 0.5, vp.Y * 0.5
                                local margin = 28
                                local inBounds = onScreen and sp.Z > 0
                                    and sp.X > margin and sp.X < vp.X - margin
                                    and sp.Y > margin and sp.Y < vp.Y - margin
                                if not inBounds then
                                    local sx, sy = sp.X, sp.Y
                                    if sp.Z < 0 then
                                        sx = cx - (sx - cx)
                                        sy = cy - (sy - cy)
                                    end
                                    local dir = Vector2.new(sx - cx, sy - cy)
                                    if dir.Magnitude < 0.001 then
                                        dir = Vector2.new(0, -1)
                                    else
                                        dir = dir.Unit
                                    end
                                    -- clamp to screen ellipse edge
                                    local rx = (vp.X * 0.5) - margin
                                    local ry = (vp.Y * 0.5) - margin
                                    local t = 1 / math.sqrt((dir.X * dir.X) / (rx * rx) + (dir.Y * dir.Y) / (ry * ry))
                                    local ax = cx + dir.X * t
                                    local ay = cy + dir.Y * t
                                    local size = math.clamp(tonumber(S.arrowsSize) or 18, 8, 40)
                                    data.arrowFrame.TextSize = size
                                    data.arrowFrame.Size = UDim2.fromOffset(size + 8, size + 8)
                                    data.arrowFrame.Position = UDim2.fromOffset(ax, ay)
                                    data.arrowFrame.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
                                    data.arrowFrame.TextColor3 = S.arrowsColor
                                    data.arrowFrame.Visible = true
                                end
                            end
                        end

                        if not S.espEnabled or not bbox then
                            -- arrows already handled
                        else
                            if data.nameLabel and data.nameLabel.Text ~= displayName then
                                data.nameLabel.Text = displayName
                            end
                            local x, y, w, h = bbox.X, bbox.Y, bbox.Width, bbox.Height
                            local healthPercent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                            local finalHealthColor = Color3.new(1, 0, 0):Lerp(S.healthBarColor, healthPercent)

                            local shieldVal, maxShieldVal = 0, 100
                            local attrShield, attrMaxShield = character:GetAttribute("Shield"), character:GetAttribute("MaxShield")
                            if type(attrShield) == "number" then
                                shieldVal = attrShield
                                if type(attrMaxShield) == "number" then maxShieldVal = attrMaxShield end
                            else
                                local shieldObj = humanoid:FindFirstChild("Shield") or character:FindFirstChild("Shield")
                                local maxShieldObj = humanoid:FindFirstChild("MaxShield") or character:FindFirstChild("MaxShield")
                                shieldVal = (shieldObj and shieldObj:IsA("ValueBase") and shieldObj.Value) or 0
                                maxShieldVal = (maxShieldObj and maxShieldObj:IsA("ValueBase") and maxShieldObj.Value) or 100
                            end
                            local showShield = S.shieldEnabled and shieldVal > 0
                            local shieldPercent, finalShieldColor = 0, S.shieldBarColor
                            if showShield then
                                shieldPercent = math.clamp(shieldVal / math.max(maxShieldVal, 1), 0, 1)
                                finalShieldColor = S.shieldBarColor:Lerp(Color3.fromRGB(50, 50, 50), 1 - shieldPercent)
                            end

                            local equippedObj = character:FindFirstChild("Equipped")
                            local weaponName = nil
                            if equippedObj and equippedObj:IsA("ObjectValue") and equippedObj.Value then
                                weaponName = "[" .. equippedObj.Value.Name .. "]"
                            end
                            local showWeapon = S.weaponEnabled and weaponName ~= nil

                            local vis = S.isEntityVisibleCached(character)
                            local visibleOk = (not S.silentVisibleCheck) or vis
                            local isTargeted = S.targetHighlightEnabled and S.silentEnabled and visibleOk and (
                                (S.currentFOVTarget ~= nil and character == S.currentFOVTarget)
                                or (S.silentTarget ~= nil and S.silentTarget.Parent ~= nil and (S.silentTarget.Parent == character or S.silentTarget:IsDescendantOf(character)))
                            )
                            local function want(elem)
                                if not isTargeted then return false end
                                if type(S.targetHighlightElement) == "table" then
                                    for _, e in ipairs(S.targetHighlightElement) do
                                        if e == elem then return true end
                                    end
                                    return false
                                end
                                return S.targetHighlightElement == elem
                            end

                            local boxTarget = want("Box")
                            local baseBoxColor
                            if boxTarget then
                                baseBoxColor = S.targetColor
                            elseif S.espVisColors then
                                baseBoxColor = vis and S.visibleColor or S.hiddenColor
                            else
                                baseBoxColor = S.boxColor
                            end

                            if S.boxEnabled then
                                data.fullFrame.Size = UDim2.new(0, w, 0, h)
                                data.fullFrame.Position = UDim2.new(0, x, 0, y)
                                data.fullFrame.Visible = true
                                local stroke = data.fullFrame:FindFirstChild("UIStroke")
                                if stroke then stroke.Color = baseBoxColor end
                            end
                            if S.filledBox and S.boxEnabled then
                                local fillTarget = want("Filled Box")
                                local fillColor
                                if fillTarget then
                                    fillColor = S.targetColor
                                elseif S.espVisColors then
                                    fillColor = vis and S.visibleColor or S.hiddenColor
                                else
                                    fillColor = S.boxColor
                                end
                                data.fillFrame.Size = UDim2.new(0, w, 0, h)
                                data.fillFrame.Position = UDim2.new(0, x, 0, y)
                                data.fillFrame.BackgroundColor3 = fillColor
                                data.fillFrame.Visible = true
                            end

                            if S.snaplineEnabled and data.snapline and cam then
                                local vp = cam.ViewportSize
                                local from = Vector2.new(vp.X / 2, vp.Y)
                                if S.snaplineFrom == "Center" then
                                    from = Vector2.new(vp.X / 2, vp.Y / 2)
                                elseif S.snaplineFrom == "Top" then
                                    from = Vector2.new(vp.X / 2, 0)
                                end
                                local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("RootPart")
                                if rootPart then
                                    local sp, onScreen = cam:WorldToViewportPoint(rootPart.Position)
                                    if onScreen and sp.Z > 0 then
                                        local snTarget = want("Snapline")
                                        local snColor
                                        if snTarget then
                                            snColor = S.targetColor
                                        elseif S.espVisColors then
                                            snColor = vis and S.visibleColor or S.hiddenColor
                                        else
                                            snColor = S.snaplineColor
                                        end
                                        local to = Vector2.new(sp.X, sp.Y)
                                        local delta = to - from
                                        local length = delta.Magnitude
                                        local midpoint = (from + to) * 0.5
                                        local angle = math.deg(math.atan2(delta.Y, delta.X))
                                        data.snapline.Size = UDim2.new(0, length, 0, S.TracerThickness)
                                        data.snapline.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
                                        data.snapline.Rotation = angle
                                        data.snapline.BackgroundColor3 = snColor
                                        data.snapline.BackgroundTransparency = S.TracerTransparency
                                        data.snapline.Visible = true
                                    end
                                end
                            end

                            -- layout stack (top → bottom), no overlap
                            -- top: knocked, name
                            -- sides: health/shield bars only (text sits beside bars, not over box)
                            -- bottom: distance · kills, weapon

                            local lineH = 13
                            local currentTopY = y - 4

                            if S.knockedEnabled and S.isKnocked(character, humanoid) then
                                currentTopY = currentTopY - lineH
                                data.knockedLabel.Text = S.knockedText
                                data.knockedLabel.TextColor3 = S.knockedColor
                                data.knockedLabel.Size = UDim2.fromOffset(math.max(w, 120), lineH)
                                data.knockedLabel.Position = UDim2.fromOffset(x + (w * 0.5) - math.max(w, 120) * 0.5, currentTopY)
                                data.knockedLabel.Visible = true
                                currentTopY = currentTopY - 2
                            end

                            if S.nameEnabled and data.nameLabel then
                                local nameTarget = want("Name")
                                local effNameColor = nameTarget and S.targetColor or S.nameColor
                                data.nameLabel.TextColor3 = effNameColor
                                currentTopY = currentTopY - lineH
                                data.nameLabel.Size = UDim2.fromOffset(math.max(w, 140), lineH)
                                data.nameLabel.Position = UDim2.fromOffset(x + (w * 0.5) - math.max(w, 140) * 0.5, currentTopY)
                                data.nameLabel.Visible = true
                            end

                            -- side bars: fixed 5px gap from box, 3px thick, second bar 4px further out
                            local barW = 3
                            local gap = 5
                            if S.healthEnabled and (S.healthPosition == "left" or S.healthPosition == "right") then
                                local barX = (S.healthPosition == "left") and (x - gap - barW) or (x + w + gap)
                                if S.healthDisplayMode == "bar" or S.healthDisplayMode == "both" then
                                    data.healthBar.Size = UDim2.fromOffset(barW, h)
                                    data.healthBar.Position = UDim2.fromOffset(barX, y)
                                    data.healthBar.Visible = true
                                    data.healthFill.Size = UDim2.new(1, 0, healthPercent, 0)
                                    data.healthFill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
                                    data.healthFill.BackgroundColor3 = finalHealthColor
                                end
                                if S.healthDisplayMode == "text" or S.healthDisplayMode == "both" then
                                    local hpText = math.floor(humanoid.Health)
                                    data.sideHealthText.Text = tostring(hpText)
                                    data.sideHealthText.Size = UDim2.fromOffset(28, 12)
                                    data.sideHealthText.AnchorPoint = Vector2.new(0.5, 0.5)
                                    local tx = (S.healthPosition == "left") and (barX - 14) or (barX + barW + 14)
                                    data.sideHealthText.Position = UDim2.fromOffset(tx, y + h * (1 - healthPercent))
                                    data.sideHealthText.Visible = true
                                end
                            end
                            if showShield and (S.shieldPosition == "left" or S.shieldPosition == "right") then
                                local extra = (S.healthEnabled and S.healthPosition == S.shieldPosition) and (barW + 4) or 0
                                local barX = (S.shieldPosition == "left") and (x - gap - barW - extra) or (x + w + gap + extra)
                                if S.shieldDisplayMode == "bar" or S.shieldDisplayMode == "both" then
                                    data.shieldBar.Size = UDim2.fromOffset(barW, h)
                                    data.shieldBar.Position = UDim2.fromOffset(barX, y)
                                    data.shieldBar.Visible = true
                                    data.shieldFill.Size = UDim2.new(1, 0, shieldPercent, 0)
                                    data.shieldFill.Position = UDim2.new(0, 0, 1 - shieldPercent, 0)
                                    data.shieldFill.BackgroundColor3 = finalShieldColor
                                end
                                if S.shieldDisplayMode == "text" or S.shieldDisplayMode == "both" then
                                    data.sideShieldText.Text = tostring(math.floor(shieldVal))
                                    data.sideShieldText.Size = UDim2.fromOffset(28, 12)
                                    data.sideShieldText.AnchorPoint = Vector2.new(0.5, 0.5)
                                    local tx = (S.shieldPosition == "left") and (barX - 14) or (barX + barW + 14)
                                    data.sideShieldText.Position = UDim2.fromOffset(tx, y + h * (1 - shieldPercent))
                                    data.sideShieldText.Visible = true
                                end
                            end

                            -- top bars (optional positions)
                            if S.healthEnabled and S.healthPosition == "top" and (S.healthDisplayMode == "bar" or S.healthDisplayMode == "both") then
                                currentTopY = currentTopY - 5
                                data.healthBar.Size = UDim2.fromOffset(w, 3)
                                data.healthBar.Position = UDim2.fromOffset(x, currentTopY)
                                data.healthBar.Visible = true
                                data.healthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
                                data.healthFill.Position = UDim2.new(0, 0, 0, 0)
                                data.healthFill.BackgroundColor3 = finalHealthColor
                            end
                            if showShield and S.shieldPosition == "top" and (S.shieldDisplayMode == "bar" or S.shieldDisplayMode == "both") then
                                currentTopY = currentTopY - 5
                                data.shieldBar.Size = UDim2.fromOffset(w, 3)
                                data.shieldBar.Position = UDim2.fromOffset(x, currentTopY)
                                data.shieldBar.Visible = true
                                data.shieldFill.Size = UDim2.new(shieldPercent, 0, 1, 0)
                                data.shieldFill.Position = UDim2.new(0, 0, 0, 0)
                                data.shieldFill.BackgroundColor3 = finalShieldColor
                            end

                            local currentBottomY = y + h + 4
                            if S.healthEnabled and S.healthPosition == "bottom" and (S.healthDisplayMode == "bar" or S.healthDisplayMode == "both") then
                                data.healthBar.Size = UDim2.fromOffset(w, 3)
                                data.healthBar.Position = UDim2.fromOffset(x, currentBottomY)
                                data.healthBar.Visible = true
                                data.healthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
                                data.healthFill.Position = UDim2.new(0, 0, 0, 0)
                                data.healthFill.BackgroundColor3 = finalHealthColor
                                currentBottomY = currentBottomY + 5
                            end
                            if showShield and S.shieldPosition == "bottom" and (S.shieldDisplayMode == "bar" or S.shieldDisplayMode == "both") then
                                data.shieldBar.Size = UDim2.fromOffset(w, 3)
                                data.shieldBar.Position = UDim2.fromOffset(x, currentBottomY)
                                data.shieldBar.Visible = true
                                data.shieldFill.Size = UDim2.new(shieldPercent, 0, 1, 0)
                                data.shieldFill.Position = UDim2.new(0, 0, 0, 0)
                                data.shieldFill.BackgroundColor3 = finalShieldColor
                                currentBottomY = currentBottomY + 5
                            end

                            -- single info line: "78m  ·  6 kills"
                            local infoParts = {}
                            if S.distanceEnabled then
                                infoParts[#infoParts + 1] = math.floor(dist) .. "m"
                            end
                            if S.killsEnabled and ent.isPlayer then
                                local killsVal = S.getKills(key)
                                if killsVal ~= nil then
                                    infoParts[#infoParts + 1] = tostring(killsVal) .. " kills"
                                end
                            end
                            if #infoParts > 0 and data.distanceLabel then
                                data.distanceLabel.Text = table.concat(infoParts, "  ·  ")
                                data.distanceLabel.TextColor3 = S.distanceColor
                                data.distanceLabel.Size = UDim2.fromOffset(math.max(w, 160), lineH)
                                data.distanceLabel.Position = UDim2.fromOffset(x + (w * 0.5) - math.max(w, 160) * 0.5, currentBottomY)
                                data.distanceLabel.Visible = true
                                currentBottomY = currentBottomY + lineH + 2
                            end
                            if data.killsLabel then data.killsLabel.Visible = false end

                            if showWeapon and data.weaponLabel then
                                data.weaponLabel.Text = weaponName
                                data.weaponLabel.TextColor3 = S.weaponColor
                                data.weaponLabel.Size = UDim2.fromOffset(math.max(w, 160), lineH)
                                data.weaponLabel.Position = UDim2.fromOffset(x + (w * 0.5) - math.max(w, 160) * 0.5, currentBottomY)
                                data.weaponLabel.Visible = true
                            end
                        end
                    end
                end
            end
        end
    end
    S.track(RunService.RenderStepped:Connect(updateESP))
end

do -- stream proof (multi-hook) + settings
    local function protectInstance(gui)
        if not gui then return false end
        local ok = false
        if syn and type(syn.protect_gui) == "function" then
            ok = pcall(syn.protect_gui, gui) or ok
        end
        if type(protect_gui) == "function" then
            ok = pcall(protect_gui, gui) or ok
        end
        if type(gethui) == "function" then
            -- already parented to gethui in most executors
            ok = true
        end
        return ok
    end

    local function setDrawingHidden(obj, hidden)
        if not obj then return end
        if type(setrenderproperty) == "function" then
            pcall(setrenderproperty, obj, "Visible", not hidden and true or false)
        end
        -- some builds expose .Visible directly still
        pcall(function()
            if hidden then
                obj.__sp_vis = obj.Visible
                obj.Visible = false
            elseif obj.__sp_vis ~= nil then
                obj.Visible = obj.__sp_vis
                obj.__sp_vis = nil
            end
        end)
    end

    local function applyStreamProof(enabled)
        S.streamProofEnabled = enabled == true
        local applied = false

        local hookList = {
            rawget(getfenv and getfenv() or _G, "setstreamproof"),
            rawget(_G, "setstreamproof"),
            rawget(_G, "set_stream_proof"),
            rawget(_G, "SetStreamProof"),
            syn and syn.set_stream_proof,
            syn and syn.setstreamproof,
            fluxus and fluxus.set_stream_proof,
            fluxus and fluxus.setstreamproof,
            krypt and krypt.set_stream_proof,
        }

        if S.streamProofEnabled then
            for _, fn in ipairs(hookList) do
                if type(fn) == "function" then
                    local ok = pcall(fn, true)
                    if ok then applied = true end
                end
            end
            -- protect ScreenGuis
            if protectInstance(S.espGui) then applied = true end
            local radar = gethui and gethui():FindFirstChild("SyntaxAimESP_Radar")
            if radar and protectInstance(radar) then applied = true end
            -- hide Drawing overlays from capture when streamproof on
            -- (OBS still sees game; this only helps executor-aware capture filters)
            if S.fovCircle then setDrawingHidden(S.fovCircle, true) end
            if S.targetLine then setDrawingHidden(S.targetLine, true) end
            -- beam tracers live in Workspace; hide by toggling Enabled
            for _, e in ipairs(S.tracerLines or {}) do
                if e.beam then pcall(function() e.beam.Enabled = false end) end
            end
        else
            for _, fn in ipairs(hookList) do
                if type(fn) == "function" then pcall(fn, false) end
            end
            if S.fovCircle then setDrawingHidden(S.fovCircle, false) end
            if S.targetLine then setDrawingHidden(S.targetLine, false) end
            for _, e in ipairs(S.tracerLines or {}) do
                if e.beam then pcall(function() e.beam.Enabled = true end) end
            end
        end

        S.streamProofApplied = applied
        if S.Library and S.Library.Notify then
            pcall(function()
                S.Library:Notify({
                    Title = "Stream Proof",
                    Text = enabled
                        and (applied and "Enabled" or "Enabled (no native hook — GUI protected only)")
                        or "Disabled"
                })
            end)
        end
    end
    S.applyStreamProof = applyStreamProof
end

do -- cleanup + unload
    local function safeDestroyGui(gui)
        if not gui then return end
        pcall(function()
            if syn and type(syn.unprotect_gui) == "function" then
                syn.unprotect_gui(gui)
            end
        end)
        pcall(function()
            if type(unprotect_gui) == "function" then
                unprotect_gui(gui)
            end
        end)
        pcall(function() gui.Enabled = false end)
        pcall(function() gui:Destroy() end)
    end

    local function DestroyAll()
        if S.destroying then return end
        S.destroying = true

        -- kill every feature flag so loops exit on next frame
        S.silentEnabled = false
        S.aimbotEnabled = false
        S.magicBulletEnabled = false
        S.triggerbotEnabled = false
        S.weaponHitscan = false
        S.espEnabled = false
        S.radarEnabled = false
        S.flightEnabled = false
        S.spinbotEnabled = false
        S.arrowsEnabled = false
        S.drawFOV = false
        S.targetLineEnabled = false
        S.bulletTracersEnabled = false
        S.fovChangerEnabled = false
        S.zoomActive = false
        S.zoomEnabled = false
        S.boxEnabled = false
        S.nameEnabled = false
        S.healthEnabled = false
        S.snaplineEnabled = false

        -- unbind known render steps even if stop helpers missing
        local RS = S.RunService or game:GetService("RunService")
        for _, name in ipairs({
            "SyntaxCombat_Pre", "SyntaxCombat_Post",
            "SyntaxAimESP", "SyntaxESP", "SyntaxRadar",
            "SyntaxMovement", "SyntaxFlight", "SyntaxSpin",
        }) do
            pcall(function() RS:UnbindFromRenderStep(name) end)
        end

        pcall(function() if S.stopCombatHooks then S.stopCombatHooks() end end)
        pcall(function() if S.stopMovement then S.stopMovement() end end)
        pcall(function() if S.destroyRadar then S.destroyRadar() end end)
        pcall(function() if S.clearSyntaxAutoLoad then S.clearSyntaxAutoLoad() end end)
        pcall(function() if S.applyStreamProof then S.applyStreamProof(false) end end)
        pcall(function() if S.unhookGunConfig then S.unhookGunConfig() end end)

        local cam = S.getCamera and S.getCamera()
        local restoreCamera = S.fovCamera or cam
        if restoreCamera and S.fovOriginal then
            pcall(function() restoreCamera.FieldOfView = S.fovOriginal end)
        end
        S.fovOriginal = nil
        S.fovCamera = nil

        if S.fovCircle then pcall(function() S.fovCircle.Visible = false end) pcall(function() S.fovCircle:Remove() end) S.fovCircle = nil end
        if S.targetLine then pcall(function() S.targetLine.Visible = false end) pcall(function() S.targetLine:Remove() end) S.targetLine = nil end
        for _, e in ipairs(S.tracerLines or {}) do
            pcall(function()
                if e.beam then e.beam:Destroy() end
                if e.a0 then e.a0:Destroy() end
                if e.a1 then e.a1:Destroy() end
                if e.p0 then e.p0:Destroy() end
                if e.p1 then e.p1:Destroy() end
            end)
        end
        S.tracerLines = {}
        if S.tracerFolder then pcall(function() S.tracerFolder:Destroy() end) S.tracerFolder = nil end
        if S.ammoLabel then pcall(function() S.ammoLabel:Destroy() end) S.ammoLabel = nil end
        if S.reloadLabel then pcall(function() S.reloadLabel:Destroy() end) S.reloadLabel = nil end

        S.memoryTarget = nil
        S.silentTarget = nil
        S.currentFOVTarget = nil

        for _, conn in ipairs(S.Connections or {}) do pcall(function() conn:Disconnect() end) end
        S.Connections = {}
        for _, conn in pairs(S.charCacheConn or {}) do pcall(function() conn:Disconnect() end) end
        S.charCacheConn = {}

        local pdKeys = {}
        for k in pairs(S.playerData or {}) do pdKeys[#pdKeys + 1] = k end
        for _, k in ipairs(pdKeys) do
            if S.cleanupPlayerESP then pcall(S.cleanupPlayerESP, k) end
        end
        S.playerData = {}
        S.partCache = {}
        S.visibilityCache = {}

        safeDestroyGui(S.espGui)
        S.espGui = nil
        pcall(function()
            local radar = (gethui and gethui() or game:GetService("CoreGui")):FindFirstChild("SyntaxAimESP_Radar")
            safeDestroyGui(radar)
        end)

        -- library window object
        pcall(function()
            local w = S.MainWindow
            if w then
                if w.Destroy then w:Destroy() end
                if w.Close then w:Close() end
                if w.Unload then w:Unload() end
            end
        end)
        local L = S.Library
        if L then
            pcall(function() if L.Unload then L:Unload() end end)
            pcall(function() if L.Destroy then L:Destroy() end end)
            pcall(function() if L.Toggle then L:Toggle(false) end end)
            pcall(function() if L.SetVisible then L:SetVisible(false) end end)
        end
        S.Library = nil
        S.MainWindow = nil

        -- brute-force ScreenGuis (protected + random names)
        local parents = {}
        pcall(function() if gethui then parents[#parents + 1] = gethui() end end)
        pcall(function() parents[#parents + 1] = game:GetService("CoreGui") end)
        pcall(function()
            local lp = game:GetService("Players").LocalPlayer
            if lp then parents[#parents + 1] = lp:FindFirstChild("PlayerGui") end
        end)
        local keep = {
            robloxgui = true, coregui = true, playerlist = true,
            bubblechat = true, chat = true, backpack = true,
            topsbar = true, topsbarapp = true,
        }
        for _, parent in ipairs(parents) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") or child:IsA("BillboardGui") or child:IsA("LayerCollector") then
                        local n = string.lower(child.Name or "")
                        local isOurs = n:find("syntax") or n:find("division") or n:find("linoria")
                            or n:find("rayfield") or n:find("wind") or n:find("haven")
                            or n:find("library") or n:find("watermark") or n:find("fortline")
                        local highOrder = (tonumber(child.DisplayOrder) or 0) >= 100
                        if isOurs or (highOrder and not keep[n]) then
                            safeDestroyGui(child)
                        end
                    end
                end
            end
        end

        getgenv().SyntaxAimESP = nil
        getgenv().__SYNTAX_EXPIRED_NOTIFIED = nil
        print("[SyntaxAimESP] Unloaded")
    end
    S.DestroyAll = DestroyAll
    getgenv().SyntaxAimESP = { Destroy = DestroyAll }
end

do
    local SettingsCat, Library = S.SettingsCat, S.Library
    local Cfg = SettingsCat:Section({ Name = "Config", Side = "Left" })
    local cfgName = Cfg:Textbox({ Name = "Config name", Placeholder = "default", Default = "default" })
    Cfg:Button({ Name = "Save", Callback = function()
        local name = "default"
        pcall(function() if cfgName and cfgName.Get then name = cfgName:Get() end end)
        local ok = false
        pcall(function() ok = Library:SaveConfig(name) end)
        pcall(function() Library:Notify({ Title = "Config", Text = ok and "Saved" or "Save failed" }) end)
    end })
    Cfg:Button({ Name = "Load", Callback = function()
        local name = "default"
        pcall(function() if cfgName and cfgName.Get then name = cfgName:Get() end end)
        local ok = false
        pcall(function() ok = Library:LoadConfig(name) end)
        pcall(function() Library:Notify({ Title = "Config", Text = ok and "Loaded" or "Load failed" }) end)
    end })

    local Privacy = SettingsCat:Section({ Name = "Privacy", Side = "Left" })
    Privacy:Toggle({ Name = "Stream Proof (best-effort)", Flag = "stream_proof", Default = false, Callback = function(v)
        if S.applyStreamProof then S.applyStreamProof(v) end
    end })

    local UnloadSection = SettingsCat:Section({ Name = "Unload", Side = "Right" })
    UnloadSection:Button({ Name = "Unload Script", Callback = function()
        -- destroy next frame so this click finishes cleanly
        task.spawn(function()
            task.wait()
            local fn = S.DestroyAll
                or (getgenv().SyntaxAimESP and getgenv().SyntaxAimESP.Destroy)
            if fn then
                local ok, err = pcall(fn)
                if not ok then
                    warn("[SyntaxAimESP] Unload error: " .. tostring(err))
                end
            else
                warn("[SyntaxAimESP] DestroyAll missing")
            end
        end)
    end })
    local Menu = SettingsCat:Section({ Name = "Menu", Side = "Right" })
    Menu:Keybind({ Name = "Menu key", Default = Enum.KeyCode.RightShift, Mode = "Always", ChangedCallback = function(k)
        if k then pcall(function() Library.MenuKeybind = k end) end
    end })
    Menu:Colorpicker({ Name = "Accent", Default = Color3.fromRGB(97, 97, 97), Callback = function(c)
        pcall(function() if Library and Library.SetAccent then Library:SetAccent(c) end end)
    end })
    Library:SetAccent(Color3.fromRGB(97, 97, 97))
end
