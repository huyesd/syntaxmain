        if typeof(v) == "Color3" then S.ammoIndicatorColor = v end
    end })
    WeaponInd:Toggle({ Name = "Reload Indicator", Flag = "reload_indicator", Default = false, Callback = function(v) S.reloadIndicatorEnabled = v end })
    WeaponInd:Colorpicker({ Name = "Reload Color", Flag = "reload_indicator_color", Default = S.reloadIndicatorColor, Callback = function(v)
        if typeof(v) == "Color3" then S.reloadIndicatorColor = v end
    end })
    WeaponInd:Toggle({ Name = "Bullet Tracers", Flag = "bullet_tracers", Default = false, Callback = function(v) S.bulletTracersEnabled = v end })
