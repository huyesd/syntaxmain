    VisSection:Colorpicker({ Name = "FOV Color", Flag = "fov_color", Default = S.fovColor, Callback = function(v)
        if typeof(v) == "Color3" then
            S.fovColor = v
            if S.fovCircle then S.fovCircle.Color = v end
        end
    end })
    VisSection:Toggle({ Name = "Targetline", Flag = "target_line", Default = false, Callback = function(v) S.targetLineEnabled = v end })
    VisSection:Colorpicker({ Name = "Targetline Color", Flag = "target_line_color", Default = S.targetLineColor, Callback = function(v)
        if typeof(v) == "Color3" then
            S.targetLineColor = v
            if S.targetLine then S.targetLine.Color = v end
        end
    end })
    VisSection:Toggle({ Name = "Highlight Target", Flag = "target_highlight", Default = false, Callback = function(v) S.targetHighlightEnabled = v end })
    VisSection:Colorpicker({ Name = "Target Color", Flag = "target_color", Default = S.targetColor, Callback = function(v)
        if typeof(v) == "Color3" then S.targetColor = v end
    end })
    VisSection:Toggle({ Name = "Show Prediction", Flag = "show_prediction", Default = false, Callback = function(v) S.showPrediction = v end })
    VisSection:Slider({
        Name = "Prediction Factor",
        Min = 0, Max = 0.5, Default = 0.12, Decimals = 2,
        Flag = "prediction_factor",
        Callback = function(v) S.predictionFactor = tonumber(v) or S.predictionFactor end
    })

    local WeaponInd = Aimbot:Section({ Name = "Weapon Indicators", Side = "Right" })
