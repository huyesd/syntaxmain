    AimSection:Slider({
        Name = "Field Of View",
        Min = 1, Max = 1000, Default = 40,
        Flag = "aim_fov",
        Callback = function(v) S.aimFOV = tonumber(v) or S.aimFOV end
    })
    AimSection:Dropdown({
        Name = "Hitbox",
        Flag = "silent_part",
        Options = { "HeadHitbox", "Head", "HumanoidRootPart", "BodyHitbox" },
        Default = "HeadHitbox",
        Callback = function(v) S.silentPart = v end
    })

    local TriggerSection = Aimbot:Section({ Name = "Triggerbot", Side = "Left" })
    TriggerSection:Toggle({ Name = "Enabled", Flag = "triggerbot_enabled", Default = false, Callback = function(v) S.triggerbotEnabled = v end })
    TriggerSection:Slider({
        Name = "Fire Delay",
        Min = 0, Max = 0.4, Default = 0.05, Decimals = 2,
        Flag = "triggerbot_delay",
        Callback = function(v) S.triggerbotDelay = tonumber(v) or S.triggerbotDelay end
    })

    local VisSection = Aimbot:Section({ Name = "Aim Visuals", Side = "Right" })
