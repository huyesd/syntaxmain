--[[ Syntax Aim + ESP + Movement — client-side flight and spin controls ]]
if getgenv().SyntaxAimESP and getgenv().SyntaxAimESP.Destroy then
    pcall(function() getgenv().SyntaxAimESP:Destroy() end)
end

local S = {}

do -- services & library
    local Library = loadstring(game:HttpGet("https://pastebin.com/raw/TSxp0FrV"))()
    if type(Library) ~= "table" then error("[SyntaxAimESP] Failed to load UI library") end
    S.Library = Library
    S.Players = game:GetService("Players")
    S.RunService = game:GetService("RunService")
    S.UIS = game:GetService("UserInputService")
    S.Workspace = game:GetService("Workspace")
    S.ReplicatedStorage = game:GetService("ReplicatedStorage")
    S.LocalPlayer = S.Players.LocalPlayer
    if not S.LocalPlayer then
        S.Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
        S.LocalPlayer = S.Players.LocalPlayer
    end
    if not S.LocalPlayer then
        error("[SyntaxAimESP] LocalPlayer unavailable")
    end
    S.Camera = S.Workspace.CurrentCamera
    gethui = gethui or function()
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok and cg then return cg end
        local lp = game:GetService("Players").LocalPlayer
        if lp then return lp:WaitForChild("PlayerGui") end
        return nil
    end
end

do -- window & categories
    local L = S.Library
    local function licenseSuffix()
        local lic = getgenv().SyntaxLicense
        if type(lic) ~= "table" then
            return '<font color="rgb(129,129,129)">v1.0.7</font>'
        end
        local plan = tostring(lic.plan or "")
        if lic.expiresAt then
            local left = lic.expiresAt - os.time()
            if left <= 0 then
                return '<font color="rgb(255,90,90)">EXPIRED</font>'
            end
            local d = math.floor(left / 86400)
            local h = math.floor((left % 86400) / 3600)
            local m = math.floor((left % 3600) / 60)
            local s = left % 60
            local t
            if d > 0 then
                t = string.format("%dd %dh", d, h)
            elseif h > 0 then
                t = string.format("%dh %dm", h, m)
            else
                t = string.format("%dm %ds", m, s)
            end
            return string.format('<font color="rgb(129,129,129)">%s</font> <font color="rgb(0,128,253)">%s</font>', plan, t)
        end
        return string.format('<font color="rgb(129,129,129)">%s</font>', plan ~= "" and plan or "LIFETIME")
    end

    local Window = L:Window({
        Icon = "rbxassetid://71390323944310",
        Name = '<font color="rgb(228,228,228)">Syn</font><font color="rgb(0,128,253)">tax</font><font color="rgb(255,255,255)"> </font>' .. licenseSuffix(),
    })
    S.MainWindow = Window
    local CombatCat   = Window:Category({ Name = "Combat" })
    local VisualsCat  = Window:Category({ Name = "Visuals", Icon = "rbxassetid://114300244607413" })
    local MiscCat = Window:Category({ Name = "Misc", Icon = "rbxassetid://114300244607413" })
    local SettingsCat = Window:Category({ Name = "Settings", Icon = "rbxassetid://118383091807292" })
    pcall(function() L:Watermark({ Title = '<font color="rgb(228,228,228)">Syn</font><font color="rgb(0,128,253)">tax</font>  ' .. licenseSuffix() }) end)

    -- live remaining on watermark; force unload when expired
    task.spawn(function()
        while true do
            if S.destroying then break end
            task.wait(1)
            if S.destroying then break end
            local lic = getgenv().SyntaxLicense
            pcall(function()
                if L.SetWatermarkTitle then
                    L:SetWatermarkTitle('<font color="rgb(228,228,228)">Syn</font><font color="rgb(0,128,253)">tax</font>  ' .. licenseSuffix())
                end
            end)
            if type(lic) == "table" and lic.expiresAt and os.time() >= lic.expiresAt then
                if not getgenv().__SYNTAX_EXPIRED_NOTIFIED then
                    getgenv().__SYNTAX_EXPIRED_NOTIFIED = true
                    pcall(function()
                        if L.Notify then
                            L:Notify({ Title = "License", Text = "Expired — unloading" })
                        end
                    end)
                    task.wait(0.4)
                    -- full teardown
                    pcall(function()
                        if S.DestroyAll then
                            S.DestroyAll()
                        elseif getgenv().SyntaxAimESP and getgenv().SyntaxAimESP.Destroy then
                            getgenv().SyntaxAimESP.Destroy()
                        end
                    end)
                    break
                end
            end
        end
    end)

    S.CombatCat = CombatCat
    S.VisualsCat = VisualsCat
    S.MiscCat = MiscCat
    S.SettingsCat = SettingsCat
    S.Aimbot = CombatCat:Page({ Name = "Combat" })
    S.MiscPage = CombatCat:Page({ Name = "Misc" })
    S.MovementPage = MiscCat:Page({ Name = "Movement" })
    S.ESPPage = VisualsCat:Page({ Name = "Player" })
    S.RadarPage = VisualsCat:Page({ Name = "Radar" })
end

do -- connections & autoload
    local Players, RunService = S.Players, S.RunService
    local Connections = {}
    S.Connections = Connections
    local function track(conn)
        if conn then Connections[#Connections + 1] = conn end
        return conn
    end
    S.track = track
    S.AUTOLOAD_FILE = "SyntaxAimESP_AutoLoad.lua"

    local function captureSyntaxSource()
        local src = getgenv().__SYNTAX_AIMESP_SOURCE
        if type(src) ~= "string" or #src == 0 then
            local okInfo, info = pcall(function()
                if not debug then return nil end
                if debug.info then return debug.info(1, "s") end
                if debug.getinfo then return debug.getinfo(1, "s") end
            end)
            if okInfo and info and type(info.source) == "string" and info.source:sub(1, 1) == "@" and readfile then
                local okRead, contents = pcall(readfile, info.source:sub(2))
                if okRead and type(contents) == "string" and #contents > 0 then src = contents end
            end
        end
        if type(src) ~= "string" or #src == 0 then
            local getSource = getscriptsource or (syn and syn.getscriptsource)
            if getSource then
                local okSource, contents = pcall(getSource)
                if okSource and type(contents) == "string" and #contents > 0 then src = contents end
            end
        end
        if type(src) == "string" and #src > 0 then
            getgenv().__SYNTAX_AIMESP_SOURCE = src
            return src
        end
        return nil
    end

    local function queueSyntaxAutoLoad()
        local src = captureSyntaxSource()
        if type(src) ~= "string" or #src == 0 then return end
        local hash = 0
        for i = 1, #src, 64 do hash = (hash * 31 + string.byte(src, i)) % 2147483647 end
        local needsWrite = true
        if getgenv().__SYNTAX_AIMESP_HASH == hash and isfile and isfile(S.AUTOLOAD_FILE) then
            needsWrite = false
        end
        if needsWrite and writefile then
            pcall(writefile, S.AUTOLOAD_FILE, src)
            getgenv().__SYNTAX_AIMESP_HASH = hash
        end
        local fileLoader = "local ok,s=pcall(readfile,'" .. S.AUTOLOAD_FILE
            .. "'); if ok and type(s)=='string' and #s>0 then getgenv().__SYNTAX_AIMESP_SOURCE=s; loadstring(s)() end"
        local qot = queue_on_teleport or (syn and syn.queue_on_teleport)
            or (fluxus and fluxus.queue_on_teleport) or queueonteleport
        if qot then pcall(qot, fileLoader) end
    end

    local function clearSyntaxAutoLoad()
        local qot = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or queueonteleport
        if qot then pcall(qot, "") end
    end

    S.clearSyntaxAutoLoad = clearSyntaxAutoLoad
    -- licensed builds: never autoload main script (would skip loader / HWID / timer)
    if type(getgenv().SyntaxLicense) == "table" then
        pcall(clearSyntaxAutoLoad)
    else
        pcall(queueSyntaxAutoLoad)
        task.spawn(function()
            local lp = Players.LocalPlayer
            if not lp then
                Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
                lp = Players.LocalPlayer
            end
            if not lp then return end
            local ok, conn = pcall(function()
                return lp.OnTeleport:Connect(function() pcall(queueSyntaxAutoLoad) end)
            end)
            if ok and conn then track(conn) end
        end)
    end

    local function getCamera()
        local cam = S.Workspace.CurrentCamera
        if cam then S.Camera = cam end
        return S.Camera
    end
    S.getCamera = getCamera

    track(S.Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        S.Camera = S.Workspace.CurrentCamera
    end))
end

