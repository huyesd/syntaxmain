do -- potassium
    local Workspace, ReplicatedStorage = S.Workspace, S.ReplicatedStorage
    local LocalPlayer = S.LocalPlayer
    local function killHiddenAntiCheat()
        if not (getnilinstances and getscriptthread and task and task.cancel) then return 0 end
        local okGet, instances = pcall(getnilinstances)
        if not okGet or type(instances) ~= "table" then return 0 end
        local killed = 0
        for _, s in ipairs(instances) do
            if s:IsA("LocalScript") then
                local n = s.Name:lower()
                local isAC = n:find("anticheat") or n:find("anti_cheat") or n:find("havocac")
                    or n:find("guard") or n:find("acclient") or n:find("ac_client")
                    or n:find("detect") or (n:sub(1, 2) == "ac" and #n <= 20)
                if isAC then
                    local okTh, thread = pcall(getscriptthread, s)
                    if okTh and thread and coroutine.status(thread) ~= "dead" then
                        if pcall(task.cancel, thread) then
                            killed = killed + 1
                            S.antiCheatLog[#S.antiCheatLog + 1] = s.Name
                        end
                    end
                end
            end
        end
        return killed
    end
    task.spawn(function()
        task.wait(2)
        local killed = killHiddenAntiCheat()
        S.antiCheatKilled = killed
        if killed > 0 then
            print(string.format("[SyntaxAimESP] Neutralised %d hidden anti-cheat script(s): %s", killed, table.concat(S.antiCheatLog, ", ")))
        else
            print("[SyntaxAimESP] No hidden anti-cheat scripts found")
        end
    end)
    task.spawn(function()
        local okRemotes, remotes = pcall(function() return ReplicatedStorage:WaitForChild("Remotes", 20) end)
        if not okRemotes or not remotes then return end
        local damageRemote = remotes:FindFirstChild("GunDamage")
        if not damageRemote then return end
        if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then return end
        local mt = getrawmetatable(game)
        if not mt or not mt.__namecall then return end
        local oldNamecall = mt.__namecall
        pcall(setreadonly, mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self == damageRemote then
                local args = { ... }
                local n = select("#", ...)

                local function validPart(p)
                    return p and typeof(p) == "Instance" and p:IsA("BasePart") and p.Parent and p:IsDescendantOf(Workspace)
                end

                local function pickTarget()
                    local t = S.silentTarget
                    if validPart(t) then return t end
                    if S.getBulletTarget then
                        local ok, p = pcall(S.getBulletTarget)
                        if ok and validPart(p) then return p end
                    end
                    if S.getClosestSilentTarget then
                        local ok, p = pcall(S.getClosestSilentTarget)
                        if ok and validPart(p) then return p end
                    end
                    return nil
                end

                -- NEVER rewrite on silent alone — silent is camera-only and rewriting
                -- GunDamage vectors is what invalidates shots. Hitscan / magic only.
                local shouldRewrite = S.weaponHitscan or S.magicBulletEnabled
                if shouldRewrite then
                    local targetPart = pickTarget()
                    if validPart(targetPart) then
                        local hitPos = targetPart.Position
                        if typeof(hitPos) == "Vector3" and hitPos.X == hitPos.X then
                            local lastVec = nil
                            for i = 1, n do
                                if typeof(args[i]) == "Vector3" then lastVec = i end
                            end
                            if lastVec then
                                if S.weaponHitscan then
                                    args[lastVec] = hitPos
                                elseif S.magicBulletEnabled then
                                    local cam = Workspace.CurrentCamera
                                    if cam then
                                        local origin = cam.CFrame.Position
                                        local dir = hitPos - origin
                                        if dir.Magnitude > 0.5 then
                                            local params = RaycastParams.new()
                                            params.FilterType = Enum.RaycastFilterType.Exclude
                                            params.FilterDescendantsInstances = { LocalPlayer.Character, targetPart.Parent }
                                            params.IgnoreWater = true
                                            local ray = Workspace:Raycast(origin, dir, params)
                                            if not ray or (ray.Instance and ray.Instance:IsDescendantOf(targetPart.Parent)) then
                                                args[lastVec] = hitPos
                                            else
                                                args[lastVec] = ray.Position
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if S.weaponDebug then
                    print(string.format("[WeaponMods][GunDamage] args=%d hitscan=%s magic=%s",
                        n, tostring(S.weaponHitscan), tostring(S.magicBulletEnabled)))
                end
                return oldNamecall(self, table.unpack(args, 1, n))
            end
            return oldNamecall(self, ...)
        end)
        pcall(setreadonly, mt, true)
        print("[SyntaxAimESP] GunDamage FireServer hook installed")
    end)
end

do -- drawing & fov target
    local DrawingLib = nil
    if type(Drawing) == "table" and type(Drawing.new) == "function" then
        DrawingLib = Drawing
    elseif Drawing ~= nil and typeof(Drawing) == "userdata" then
        DrawingLib = Drawing
    end
    if not DrawingLib then warn("[SyntaxAimESP] Drawing library not available") end
    S.DrawingLib = DrawingLib
    local Players, UIS = S.Players, S.UIS
    local LocalPlayer = S.LocalPlayer
    local getCamera = S.getCamera
    S.currentFOVTarget = nil
    local function findFOVTargetCharacter()
        local cam = getCamera()
        if not cam or S.aimFOV <= 0 then return nil end
        local mousePos = UIS:GetMouseLocation()
        local bestChar, bestDist = nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = char:FindFirstChild(S.silentPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and screenPos.Z > 0 then
                            local d = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                            if d <= S.aimFOV and d < bestDist then bestDist = d; bestChar = char end
                        end
                    end
                end
            end
        end
        return bestChar
    end
    S.findFOVTargetCharacter = findFOVTargetCharacter

    local fovCircle
    if DrawingLib and type(DrawingLib.new) == "function" then
        local ok, c = pcall(function() return DrawingLib.new("Circle") end)
        if ok and c then
            fovCircle = c
            fovCircle.Thickness = 1.5
            fovCircle.Color = S.fovColor
            fovCircle.Transparency = 0.5
            fovCircle.Filled = false
            fovCircle.Visible = false
        end
    end
    S.fovCircle = fovCircle

    local targetLine
    if DrawingLib and type(DrawingLib.new) == "function" then
        local ok, line = pcall(function() return DrawingLib.new("Line") end)
        if ok and line then
            targetLine = line
            targetLine.Thickness = 1.5
            targetLine.Color = S.targetLineColor
            targetLine.Transparency = 0.25
            targetLine.Visible = false
        end
    end
    S.targetLine = targetLine

    local RunService = S.RunService
    S.track(RunService.RenderStepped:Connect(function()
        if S.destroying then return end
        local mousePos = UIS:GetMouseLocation()
        local pos = Vector2.new(mousePos.X, mousePos.Y)
        if (S.targetHighlightEnabled or S.silentEnabled or S.aimbotEnabled or S.magicBulletEnabled) and S.aimFOV > 0 then
            S.currentFOVTarget = findFOVTargetCharacter()
        else
            S.currentFOVTarget = nil
        end
        if S.fovCircle then
            if S.drawFOV then
                S.fovCircle.Position = pos
                S.fovCircle.Radius = S.aimFOV
                S.fovCircle.Color = S.fovColor
                S.fovCircle.Visible = true
            else
                S.fovCircle.Visible = false
            end
        end
        if S.targetLine then
            local show = false
            if S.targetLineEnabled then
                local part = S.silentTarget
                if part and part.Parent then
                    local cam = getCamera()
                    if cam then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 then
                            S.targetLine.From = pos
                            S.targetLine.To = Vector2.new(sp.X, sp.Y)
                            S.targetLine.Color = S.targetLineColor
                            S.targetLine.Visible = true
                            show = true
                        end
                    end
                end
            end
            if not show then S.targetLine.Visible = false end
        end
    end))
end

do -- silent aim
    local Players, Workspace, UIS = S.Players, S.Workspace, S.UIS
    local LocalPlayer = S.LocalPlayer
    local RunService = S.RunService
    local getCamera = S.getCamera
    local COMBAT_PRE = "SyntaxCombat_Pre"
    local COMBAT_POST = "SyntaxCombat_Post"
    local savedCF, aimed = nil, false

    local function partStillValid(part)
        if not part or not part.Parent then return false end
        local char = part.Parent
        if not char or not char.Parent then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local cam = getCamera()
        if not cam then return false end
        local worldDist = (cam.CFrame.Position - part.Position).Magnitude
        if worldDist > S.silentDistance then return false end
        if S.silentVisibleCheck then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { LocalPlayer.Character, char }
            rayParams.IgnoreWater = true
            local ray = Workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rayParams)
            if ray then return false end
        end
        return true
    end

    local function getClosestSilentTarget()
        local cam = getCamera()
        if not cam then return nil end

        -- Memory / Keep Target: prefer sticky target while still valid
        if (S.memoryAim or S.keepTarget) and S.memoryTarget and partStillValid(S.memoryTarget) then
            local mousePos = UIS:GetMouseLocation()
            local screenPos, onScreen = cam:WorldToViewportPoint(S.memoryTarget.Position)
            if onScreen and screenPos.Z > 0 then
                local screenDist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if S.keepTarget or screenDist <= S.aimFOV * 1.35 then
                    return S.memoryTarget
                end
            elseif S.keepTarget then
                return S.memoryTarget
            end
        end

        local bestTarget, shortestAngle = nil, math.huge
        local mousePos = UIS:GetMouseLocation()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local targetPart = char:FindFirstChild(S.silentPart)
                        or char:FindFirstChild("HeadHitbox")
                        or char:FindFirstChild("Head")
                        or char:FindFirstChild("HumanoidRootPart")
                        or char:FindFirstChild("BodyHitbox")
                    if targetPart then
                        local worldDist = (cam.CFrame.Position - targetPart.Position).Magnitude
                        if worldDist <= S.silentDistance then
                            local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                            if onScreen and screenPos.Z > 0 then
                                local screenDist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                                if screenDist <= S.aimFOV and screenDist < shortestAngle then
                                    local pass = true
                                    if S.silentVisibleCheck then
                                        local rayParams = RaycastParams.new()
                                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                        rayParams.FilterDescendantsInstances = { LocalPlayer.Character, char }
                                        rayParams.IgnoreWater = true
                                        local ray = Workspace:Raycast(cam.CFrame.Position, targetPart.Position - cam.CFrame.Position, rayParams)
                                        if ray then pass = false end
                                    end
                                    if pass then
                                        shortestAngle = screenDist
                                        bestTarget = targetPart
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if bestTarget and (S.memoryAim or S.keepTarget) then
            S.memoryTarget = bestTarget
        end
        return bestTarget
    end
    S.getClosestSilentTarget = getClosestSilentTarget

    local function getBulletTarget()
        local cam = getCamera()
        if not cam then return nil end
        local bestPart, bestDist = nil, math.huge
        local mousePos = UIS:GetMouseLocation()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = char:FindFirstChild(S.bulletModsPart) or char:FindFirstChild("HeadHitbox")
                        or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("RootPart")
                    if part and part:IsA("BasePart") then
                        local worldDist = (cam.CFrame.Position - part.Position).Magnitude
                        if worldDist <= S.bulletModsRange then
                            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                            if onScreen and screenPos.Z > 0 then
                                local screenDist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                                if screenDist <= S.bulletModsFOV and screenDist < bestDist then
                                    bestDist = screenDist; bestPart = part
                                end
                            end
                        end
                    end
                end
            end
        end
        return bestPart
    end
    S.getBulletTarget = getBulletTarget

    local function isLineBlocked(fromPos, toPos, targetChar)
        local dir = toPos - fromPos
        if dir.Magnitude < 0.5 then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character, targetChar }
        params.IgnoreWater = true
        return Workspace:Raycast(fromPos, dir, params) ~= nil
    end

    local function predictPosition(part)
        if not S.showPrediction or not part then return part.Position end
        local parent = part.Parent
        local root = parent and (parent:FindFirstChild("HumanoidRootPart") or parent:FindFirstChild("RootPart") or part)
        local vel = root and root.AssemblyLinearVelocity or Vector3.zero
        local factor = math.clamp(tonumber(S.predictionFactor) or 0.12, 0, 0.5)
        return part.Position + vel * factor
    end

    local function fireTriggerbot()
        if not S.triggerbotEnabled then return end
        local now = os.clock()
        if now - (S.triggerbotLastFire or 0) < (tonumber(S.triggerbotDelay) or 0.05) then return end
        S.triggerbotLastFire = now
        -- mouse click simulation (executor dependent)
        if mouse1press and mouse1release then
            pcall(mouse1press)
            task.delay(0.02, function() pcall(mouse1release) end)
        elseif mouse1click then
            pcall(mouse1click)
        else
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                if vim then
                    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.delay(0.02, function()
                        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end)
                end
            end)
        end
    end

    local function combatPre()
        local cam = getCamera()
        if not cam then return end
        local bulletActive = S.magicBulletEnabled
        local aimActive = S.silentEnabled or S.aimbotEnabled
        if not (bulletActive or aimActive or S.triggerbotEnabled) then return end
        if UIS:GetFocusedTextBox() or shared.HavocMenuOpen then return end

        -- controller: treat RT as aim hold when support on
        local aimHeld = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if S.controllerSupport then
            local ok, down = pcall(function()
                return UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL2)
                    or UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2)
            end)
            if ok and down then aimHeld = true end
        end

        local camPos = cam.CFrame.Position
        local targetPart = nil
        if bulletActive then targetPart = getBulletTarget() end
        if not targetPart and aimActive then
            targetPart = getClosestSilentTarget()
            if targetPart then S.silentTarget = targetPart end
        elseif targetPart and S.silentEnabled then
            S.silentTarget = targetPart
        end
        if not targetPart and S.triggerbotEnabled then
            targetPart = getClosestSilentTarget()
            if targetPart then S.silentTarget = targetPart end
        end
        if not targetPart then
            if not S.keepTarget then S.memoryTarget = nil end
            return
        end

        local targetChar = targetPart.Parent
        local targetPos = predictPosition(targetPart)
        local delta = targetPos - camPos
        if delta.Magnitude < 0.5 then return end
        local blocked = isLineBlocked(camPos, targetPos, targetChar)
        if S.magicBulletEnabled and blocked then
            if aimActive then
                targetPart = getClosestSilentTarget()
                if targetPart then
                    S.silentTarget = targetPart
                    targetChar = targetPart.Parent
                    targetPos = predictPosition(targetPart)
                    delta = targetPos - camPos
                    if delta.Magnitude < 0.5 then return end
                    blocked = isLineBlocked(camPos, targetPos, targetChar)
                end
            else
                targetPart = nil
            end
            if not targetPart then return end
        end
        local magicOk = S.magicBulletEnabled and not blocked
        local shouldAim = aimActive or magicOk
        if not shouldAim and not S.triggerbotEnabled then return end

        if S.triggerbotEnabled and targetPart then
            local mousePos = UIS:GetMouseLocation()
            local sp, onScreen = cam:WorldToViewportPoint(targetPart.Position)
            if onScreen and sp.Z > 0 then
                local d = (mousePos - Vector2.new(sp.X, sp.Y)).Magnitude
                if d <= math.max(8, S.aimFOV * 0.15) then
                    fireTriggerbot()
                end
            end
        end

        if not shouldAim then return end

        -- Silent only: snap camera for this frame, restore in combatPost.
        -- Does not touch remotes — that was breaking guns.
        if S.silentEnabled or magicOk then
            local originalCF = cam.CFrame
            cam.CFrame = CFrame.lookAt(camPos, targetPos)
            savedCF = originalCF
            aimed = true
            S.silentTarget = targetPart
            if bulletActive then
                S.bulletDebugModel = targetChar
                S.bulletDebugAt = os.clock()
            end
        end
    end

    local function combatPost()
        local cam = getCamera()
        if not cam then aimed, savedCF = false, nil; return end
        if aimed and savedCF then
            cam.CFrame = savedCF
        end
        aimed, savedCF = false, nil
    end

    local combatHooksBound = false
    local function bindRenderStep(name, priority, fn)
        local ok = pcall(function() RunService:BindToRenderStep(name, priority, fn) end)
        if not ok then pcall(function() RunService:BindToRenderStep(name, math.floor(priority), fn) end) end
    end
    S.startCombatHooks = function()
        if combatHooksBound then return end
        combatHooksBound = true
        bindRenderStep(COMBAT_PRE, Enum.RenderPriority.Camera.Value + 1, combatPre)
        bindRenderStep(COMBAT_POST, Enum.RenderPriority.Camera.Value + 3, combatPost)
    end
    S.stopCombatHooks = function()
        if not combatHooksBound then return end
        combatHooksBound = false
        pcall(function() RunService:UnbindFromRenderStep(COMBAT_PRE) end)
        pcall(function() RunService:UnbindFromRenderStep(COMBAT_POST) end)
        local cam = getCamera()
        if aimed and savedCF and cam then cam.CFrame = savedCF end
        aimed, savedCF = false, nil
    end
    task.spawn(S.startCombatHooks)
end

do -- gun damage debug
    local ReplicatedStorage = S.ReplicatedStorage
    local LocalPlayer = S.LocalPlayer
    local track = S.track
    task.spawn(function()
        local okRemotes, remotes = pcall(function() return ReplicatedStorage:WaitForChild("Remotes", 20) end)
        if not okRemotes or not remotes then return end
        local damageRemote = remotes:FindFirstChild("GunDamage")
        if not (damageRemote and damageRemote:IsA("RemoteEvent")) then return end
        track(damageRemote.OnClientEvent:Connect(function(pos, damage, headshot, kill, attacker)
            if not S.bulletModsDebug then return end
            if not S.bulletDebugModel or os.clock() - S.bulletDebugAt > 2 then return end
            if typeof(attacker) == "Instance" then
                if attacker:IsA("Player") and attacker ~= LocalPlayer then return end
                if attacker:IsA("Model") and attacker ~= LocalPlayer.Character then return end
            end
            local targetPos
            local part = S.bulletDebugModel:FindFirstChild("HeadHitbox") or S.bulletDebugModel:FindFirstChild("Head")
                or S.bulletDebugModel:FindFirstChild("HumanoidRootPart") or S.bulletDebugModel:FindFirstChild("RootPart")
            if part and part:IsA("BasePart") then targetPos = part.Position end
            local nearTarget = targetPos ~= nil and typeof(pos) == "Vector3" and (pos - targetPos).Magnitude <= 10
            print(string.format("[BulletMods] damage=%s headshot=%s kill=%s nearTarget=%s attacker=%s",
                tostring(damage), tostring(headshot), tostring(kill), tostring(nearTarget), tostring(attacker)))
        end))
    end)
end

